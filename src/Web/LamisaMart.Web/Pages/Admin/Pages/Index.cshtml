@page "/Admin/Pages"
@using System.Text.Encodings.Web
@model LamisaMart.Web.Pages.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "Application Pages Management - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Application Pages Directory & CMS Editor</h3>
        <p class="text-muted small mb-0">Browse, edit, create, and manage all public application pages, legal documents, and SEO metadata.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createPageModal">
            <i class="bi bi-file-earmark-plus me-1"></i> Create Custom Page
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Page Title & Details</th>
                    <th class="py-3">URL Route / Slug</th>
                    <th class="py-3">Menu Placements</th>
                    <th class="py-3 text-center">Status</th>
                    <th class="py-3 text-center">Store Views</th>
                    <th class="py-3 text-end">Last Updated</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pageItem in Model.PagesList)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 bg-danger-subtle text-danger p-2.5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-file-earmark-text fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0 fs-7">@pageItem.Title</h6>
                                    <span class="text-muted fs-8">SEO Title: @(string.IsNullOrWhiteSpace(pageItem.MetaTitle) ? pageItem.Title : pageItem.MetaTitle)</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <code class="text-danger fw-bold bg-danger-subtle px-2 py-1 rounded fs-7">@pageItem.Route</code>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @if (pageItem.ShowInHeader)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8"><i class="bi bi-layout-sidebar me-1"></i>Header Menu</span>
                                }
                                @if (pageItem.ShowInFooter)
                                {
                                    <span class="badge bg-light text-dark border fs-8"><i class="bi bi-layout-south me-1"></i>Footer Links</span>
                                }
                            </div>
                        </td>
                        <td class="text-center">
                            @if (pageItem.Status == "Published")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fs-7">
                                    <i class="bi bi-check-circle-fill me-1"></i> Live & Published
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1 fs-7">
                                    <i class="bi bi-pencil me-1"></i> Draft
                                </span>
                            }
                        </td>
                        <td class="text-center fw-bold text-dark fs-7">
                            @pageItem.ViewsCount.ToString("N0")
                        </td>
                        <td class="text-end text-muted fs-7">
                            @pageItem.UpdatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <!-- Live Storefront Preview -->
                                <a href="@pageItem.Route" target="_blank" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                   style="width: 32px; height: 32px;" title="View Live Page">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <!-- Edit Page Content Modal Trigger -->
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px;"
                                        title="Edit Page Content & SEO"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editPageModal"
                                        onclick="populateEditPageModal('@pageItem.Id', '@pageItem.Title', '@pageItem.Route', '@JavaScriptEncoder.Default.Encode(pageItem.ContentHtml)', @(pageItem.ShowInHeader ? "true" : "false"), @(pageItem.ShowInFooter ? "true" : "false"), '@pageItem.Status', '@JavaScriptEncoder.Default.Encode(pageItem.MetaTitle)', '@JavaScriptEncoder.Default.Encode(pageItem.MetaDescription)')">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <!-- Toggle Published / Draft -->
                                <form method="post" asp-page-handler="ToggleStatus" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pageItem.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning text-dark rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                            style="width: 32px; height: 32px;" title="Toggle Published / Draft">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>

                                <!-- Delete Page -->
                                <form method="post" asp-page-handler="DeletePage" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this page?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pageItem.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                            style="width: 32px; height: 32px;" title="Delete Page">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create New Page -->
<div class="modal fade" id="createPageModal" tabindex="-1" aria-labelledby="createPageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createPageModalLabel"><i class="bi bi-file-earmark-plus me-1 text-danger"></i> Create New Custom Application Page</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="CreatePage">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Page Title <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Eid Special Collection 2026" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">URL Route / Slug <span class="text-danger">*</span></label>
                            <input type="text" name="route" class="form-control rounded-3" placeholder="e.g. /eid-collection" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Page Body Content (HTML / Text)</label>
                        <textarea name="contentHtml" class="form-control rounded-3" rows="6" placeholder="Enter page HTML markup, headings, paragraphs, and product descriptions..."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" name="showInHeader" value="true" id="cHeader" />
                                <label class="form-check-label fw-bold text-dark small" for="cHeader">Show in Top Header Menu</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" name="showInFooter" value="true" id="cFooter" checked />
                                <label class="form-check-label fw-bold text-dark small" for="cFooter">Show in Footer Quick Links</label>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <h6 class="fw-bold text-dark fs-7 mb-2"><i class="bi bi-search me-1 text-primary"></i> Search Engine Optimization (SEO)</h6>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">SEO Meta Title</label>
                            <input type="text" name="metaTitle" class="form-control form-control-sm rounded-3" placeholder="Search engine title tag..." />
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-1">SEO Meta Description</label>
                            <textarea name="metaDescription" class="form-control form-control-sm rounded-3" rows="2" placeholder="Brief summary snippet for Google search results..."></textarea>
                        </div>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="button" class="btn btn-light rounded-pill me-2 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Publish Page
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Page Content & SEO -->
<div class="modal fade" id="editPageModal" tabindex="-1" aria-labelledby="editPageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editPageModalLabel"><i class="bi bi-pencil-square me-1 text-danger"></i> Edit Page Content & SEO Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="EditPage">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editPageId" name="id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Page Title <span class="text-danger">*</span></label>
                            <input type="text" id="editPageTitle" name="title" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">URL Route / Slug <span class="text-danger">*</span></label>
                            <input type="text" id="editPageRoute" name="route" class="form-control rounded-3" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Page Body Content (HTML / Text)</label>
                        <textarea id="editPageContentHtml" name="contentHtml" class="form-control rounded-3 font-monospace fs-7" rows="7"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" id="editShowInHeader" name="showInHeader" value="true" />
                                <label class="form-check-label fw-bold text-dark small" for="editShowInHeader">Header Menu</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" id="editShowInFooter" name="showInFooter" value="true" />
                                <label class="form-check-label fw-bold text-dark small" for="editShowInFooter">Footer Links</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark">Publishing Status</label>
                            <select id="editPageStatus" name="status" class="form-select form-select-sm rounded-3">
                                <option value="Published">Published (Live)</option>
                                <option value="Draft">Draft (Hidden)</option>
                            </select>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <h6 class="fw-bold text-dark fs-7 mb-2"><i class="bi bi-search me-1 text-primary"></i> Search Engine Optimization (SEO)</h6>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">SEO Meta Title</label>
                            <input type="text" id="editMetaTitle" name="metaTitle" class="form-control form-control-sm rounded-3" />
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-1">SEO Meta Description</label>
                            <textarea id="editMetaDescription" name="metaDescription" class="form-control form-control-sm rounded-3" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="button" class="btn btn-light rounded-pill me-2 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save Page Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function populateEditPageModal(id, title, route, content, header, footer, status, metaTitle, metaDesc) {
            document.getElementById('editPageId').value = id;
            document.getElementById('editPageTitle').value = title;
            document.getElementById('editPageRoute').value = route;
            document.getElementById('editPageContentHtml').value = content;
            document.getElementById('editShowInHeader').checked = header;
            document.getElementById('editShowInFooter').checked = footer;
            document.getElementById('editPageStatus').value = status;
            document.getElementById('editMetaTitle').value = metaTitle;
            document.getElementById('editMetaDescription').value = metaDesc;
        }
    </script>
}
