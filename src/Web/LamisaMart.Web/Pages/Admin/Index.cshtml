@page
@model LamisaMart.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "SuperAdmin Dashboard";
    Layout = "_AdminLayout";
}

<!-- Top Header Row -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-extrabold text-dark m-0">SuperAdmin Overview</h3>
        <p class="text-muted small mb-0">Platform performance, vendor applications, live revenue, and order management.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 fw-semibold" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh Stats
        </button>
        <a href="/Admin/Vendors" class="btn btn-danger btn-sm rounded-pill px-3 py-2 fw-bold shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Manage Vendors
        </a>
    </div>
</div>

<!-- Key Performance Indicators (KPI Cards) -->
<div class="row g-3 g-md-4 mb-4">
    <!-- Gross Revenue -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 h-100 card-stat border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Gross Revenue (GMV)</span>
                <div class="rounded-circle bg-primary-subtle text-primary p-2">
                    <i class="bi bi-currency-exchange fs-5"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark m-0">৳ @Model.TotalRevenue.ToString("N0")</h3>
            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                <span class="text-success small fw-semibold"><i class="bi bi-arrow-up-right me-1"></i> +14.2% MoM</span>
                <span class="badge bg-primary-subtle text-primary fs-7">Commissions: ৳@Model.TotalCommissionEarned.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- Total Orders -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 h-100 card-stat border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Total Orders</span>
                <div class="rounded-circle bg-success-subtle text-success p-2">
                    <i class="bi bi-bag-check fs-5"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark m-0">@Model.TotalOrders.ToString("N0")</h3>
            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                <span class="text-success small fw-semibold"><i class="bi bi-arrow-up-right me-1"></i> +8.5% this week</span>
                <span class="text-muted fs-7">98.4% Fulfillment</span>
            </div>
        </div>
    </div>

    <!-- Active Vendors -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 h-100 card-stat border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Active Vendors</span>
                <div class="rounded-circle bg-warning-subtle text-warning p-2">
                    <i class="bi bi-shop fs-5"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark m-0">@Model.ActiveVendorsCount</h3>
            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                <span class="text-danger small fw-semibold"><i class="bi bi-clock-history me-1"></i> @Model.PendingVendorsCount Pending Approval</span>
                <a href="/Admin/Vendors" class="text-decoration-none small text-primary fw-bold">Review <i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Pending Payouts -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 h-100 card-stat border-start border-4 border-danger">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Pending Payouts</span>
                <div class="rounded-circle bg-danger-subtle text-danger p-2">
                    <i class="bi bi-wallet2 fs-5"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark m-0">৳ @Model.PendingPayoutsAmount.ToString("N0")</h3>
            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                <span class="text-muted fs-7">To 28 Vendors</span>
                <a href="/Admin/Accounting" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-0 fs-7 fw-bold">Process Payouts</a>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Analytics Charts Row -->
<div class="row g-4 mb-4">
    <!-- Revenue Trend Chart -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark m-0">Platform Revenue Growth (BDT)</h6>
                    <span class="text-muted fs-7">Monthly Sales Volume & Platform Commission</span>
                </div>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary active">2026</button>
                    <button type="button" class="btn btn-outline-secondary">2025</button>
                </div>
            </div>
            <div class="card-body p-4">
                <div style="height: 280px; position: relative;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Sales Breakdown Chart -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h6 class="fw-bold text-dark m-0">Sales by Category</h6>
                <span class="text-muted fs-7">Percentage of total orders</span>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center">
                <div style="height: 250px; width: 100%; position: relative;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders & Pending Vendor Approvals Table Row -->
<div class="row g-4 mb-4">
    <!-- Recent Platform Orders -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark m-0">Recent Platform Orders</h6>
                    <span class="text-muted fs-7">Latest customer transactions across all vendors</span>
                </div>
                <a href="/Admin/Orders" class="btn btn-sm btn-link text-danger text-decoration-none fw-bold">
                    View All Orders <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0 pt-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small border-bottom">
                            <tr>
                                <th class="ps-4">Order ID</th>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th class="pe-4 text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark fs-7">@order.OrderNumber</td>
                                    <td class="fw-medium text-dark fs-7">@order.CustomerName</td>
                                    <td class="text-muted fs-7">@order.Phone</td>
                                    <td class="text-muted fs-7">@order.OrderDate.ToString("MMM dd, HH:mm")</td>
                                    <td>
                                        @if (order.Status == "Delivered")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Delivered</span>
                                        }
                                        else if (order.Status == "Processing" || order.Status == "Confirmed")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">Processing</span>
                                        }
                                        else if (order.Status == "Shipped")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Shipped</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill">@order.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fs-7">@order.PaymentMethod</span>
                                    </td>
                                    <td class="pe-4 text-end fw-extrabold text-dark">৳ @order.TotalAmount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Vendor Applications Widget -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark m-0">Pending Vendor Approvals</h6>
                    <span class="text-muted fs-7">Action required</span>
                </div>
                <span class="badge bg-warning text-dark rounded-pill fw-bold">@Model.PendingVendors.Count Pending</span>
            </div>
            <div class="card-body p-3">
                @if (Model.PendingVendors != null && Model.PendingVendors.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var vendor in Model.PendingVendors)
                        {
                            <div class="p-3 rounded-4 bg-light border d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="fw-bold text-dark m-0 fs-7">@vendor.StoreName</h6>
                                        <span class="text-muted fs-7">@vendor.BusinessName</span>
                                    </div>
                                    <span class="badge bg-light text-secondary border fs-7">@vendor.RegistrationNumber</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-10">
                                    <span class="text-muted fs-7"><i class="bi bi-calendar-event me-1"></i> @vendor.ApplicationDate.ToString("MMM dd")</span>
                                    <form method="post" asp-page-handler="ApproveVendor" asp-route-vendorId="@vendor.VendorId" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-bold fs-7 shadow-sm">
                                            <i class="bi bi-check-lg me-1"></i> Approve Store
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check-circle text-success fs-2 mb-2 d-block"></i>
                        <p class="small mb-0">No pending vendor applications!</p>
                    </div>
                }

                <div class="mt-4 pt-3 border-top text-center">
                    <a href="/Admin/Vendors" class="btn btn-outline-dark btn-sm rounded-pill px-4 fw-semibold">
                        View All Vendors Directory
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Revenue Chart
            const ctxRev = document.getElementById('revenueChart');
            if (ctxRev) {
                new Chart(ctxRev, {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'],
                        datasets: [
                            {
                                label: 'Gross Revenue (BDT)',
                                data: [650000, 780000, 920000, 1100000, 1250000, 1380000, 1420000, 1450200],
                                borderColor: '#E11D48',
                                backgroundColor: 'rgba(225, 29, 72, 0.1)',
                                fill: true,
                                tension: 0.3,
                                borderWidth: 3
                            },
                            {
                                label: 'Platform Commission (8%)',
                                data: [52000, 62400, 73600, 88000, 100000, 110400, 113600, 116016],
                                borderColor: '#3B82F6',
                                backgroundColor: 'transparent',
                                borderDash: [5, 5],
                                tension: 0.3,
                                borderWidth: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            y: {
                                ticks: {
                                    callback: function(value) { return '৳' + (value / 1000) + 'k'; }
                                }
                            }
                        }
                    }
                });
            }

            // Category Chart
            const ctxCat = document.getElementById('categoryChart');
            if (ctxCat) {
                new Chart(ctxCat, {
                    type: 'doughnut',
                    data: {
                        labels: ['Saree', 'Three Piece', 'Kurti', 'Jewelry', 'Cosmetics', 'Others'],
                        datasets: [{
                            data: [40, 25, 15, 10, 6, 4],
                            backgroundColor: ['#E11D48', '#3B82F6', '#10B981', '#F59E0B', '#8B5CF6', '#64748B']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
        });
    </script>
}
