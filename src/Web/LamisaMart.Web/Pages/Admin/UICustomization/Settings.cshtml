@page "/Admin/UICustomization/Settings"
@model LamisaMart.Web.Pages.Admin.UICustomization.SettingsModel
@{
    ViewData["Title"] = "UI Theme & Style Settings - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">UI Theme & Style Settings</h3>
        <p class="text-muted small mb-0">Configure primary brand color palettes, Google typography fonts, dark mode switches, and custom CSS injectors.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-5">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()

            <!-- Brand Colors -->
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-palette me-1 text-danger"></i> Brand Color Palette</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small text-dark">Primary Accent Color</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="color" asp-for="PrimaryColor" class="form-control form-control-color rounded-3" />
                        <input type="text" asp-for="PrimaryColor" class="form-control rounded-3 font-monospace fs-7" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small text-dark">Secondary Dark Accent</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="color" asp-for="SecondaryColor" class="form-control form-control-color rounded-3" />
                        <input type="text" asp-for="SecondaryColor" class="form-control rounded-3 font-monospace fs-7" />
                    </div>
                </div>
            </div>

            <!-- Typography & Theme Modes -->
            <h6 class="fw-bold text-dark border-top pt-3 mb-3"><i class="bi bi-fonts me-1 text-primary"></i> Typography & Theme Modes</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small text-dark">Global Body Font Family</label>
                    <select asp-for="BodyFontFamily" class="form-select rounded-3">
                        <option value="Inter" selected>Inter (Clean Modern Sans-Serif)</option>
                        <option value="Outfit">Outfit (Fashion & Luxury Styling)</option>
                        <option value="Roboto">Roboto (Google Standard)</option>
                        <option value="Hind Siliguri">Hind Siliguri (Optimized Bangla & English)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch pt-4">
                        <input class="form-check-input" type="checkbox" asp-for="EnableDarkModeToggle" id="chkDark" />
                        <label class="form-check-label fw-bold text-dark" for="chkDark">Enable Dark / Light Mode Switcher Widget</label>
                    </div>
                </div>
            </div>

            <!-- Custom CSS & Script Injectors -->
            <h6 class="fw-bold text-dark border-top pt-3 mb-3"><i class="bi bi-code-slash me-1 text-primary"></i> Custom CSS & Script Injector</h6>
            <div class="mb-3">
                <label class="form-label fw-semibold small text-dark">Custom Storefront CSS Code</label>
                <textarea asp-for="CustomCssCode" class="form-control rounded-3 font-monospace fs-7" rows="4"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small text-dark">Header Scripts Code (GTAG / Pixel)</label>
                <textarea asp-for="HeaderScriptsCode" class="form-control rounded-3 font-monospace fs-7" rows="3"></textarea>
            </div>

            <div class="pt-4 border-top mt-4 text-end">
                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-floppy me-1"></i> Save Theme Settings
                </button>
            </div>
        </form>
    </div>
</div>
