@page "/Admin/UICustomization/Slider"
@using System.Text.Encodings.Web
@model LamisaMart.Web.Pages.Admin.UICustomization.SliderModel
@{
    ViewData["Title"] = "Hero Slider Customization - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Storefront Hero Slider & Banner Customization</h3>
        <p class="text-muted small mb-0">Manage home page hero banner slides with direct image uploads or URL links, headline text, promotional badges, and action buttons.</p>
    </div>
    <div>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addSlideModal">
            <i class="bi bi-cloud-arrow-up me-1"></i> Add New Hero Slide
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Slides Grid / Cards -->
<div class="row g-4 mb-5">
    @foreach (var slide in Model.SlidesList)
    {
        <div class="col-lg-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 position-relative">
                <!-- Slide Image Preview -->
                <div class="position-relative bg-dark" style="height: 200px;">
                    <img src="@slide.ImageUrl" class="w-100 h-100 object-fit-cover opacity-85" alt="@slide.Title" />
                    <div class="position-absolute top-0 start-0 m-3">
                        <span class="badge bg-dark bg-opacity-75 text-white border fs-8">Order: #@slide.SortOrder</span>
                    </div>
                    <div class="position-absolute top-0 end-0 m-3">
                        @if (slide.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-8">
                                <i class="bi bi-check-circle-fill me-1"></i> Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill fs-8">
                                <i class="bi bi-eye-slash me-1"></i> Inactive
                            </span>
                        }
                    </div>
                </div>

                <!-- Slide Content Details -->
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(slide.BadgeText))
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-8 mb-2">@slide.BadgeText</span>
                        }
                        <h5 class="fw-bold text-dark mb-2 fs-6">@slide.Title</h5>
                        <p class="text-muted small mb-3 text-truncate-2" style="font-size: 0.85rem;">@slide.Subtitle</p>

                        <div class="p-2.5 bg-light rounded-3 border mb-3">
                            <div class="d-flex align-items-center justify-content-between fs-8">
                                <span class="text-muted"><i class="bi bi-link-45deg me-1"></i> Target Button:</span>
                                <code class="text-danger fw-bold">@slide.ButtonText &rarr; @slide.ButtonLink</code>
                            </div>
                        </div>
                    </div>

                    <!-- Slide Action Controls -->
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-2">
                        <!-- Edit Button -->
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold"
                                data-bs-toggle="modal"
                                data-bs-target="#editSlideModal"
                                onclick="populateEditSlideModal('@slide.Id', '@JavaScriptEncoder.Default.Encode(slide.ImageUrl)', '@JavaScriptEncoder.Default.Encode(slide.BadgeText)', '@JavaScriptEncoder.Default.Encode(slide.Title)', '@JavaScriptEncoder.Default.Encode(slide.Subtitle)', '@JavaScriptEncoder.Default.Encode(slide.ButtonText)', '@JavaScriptEncoder.Default.Encode(slide.ButtonLink)', '@slide.TextAlignment', @slide.SortOrder, @(slide.IsActive ? "true" : "false"))">
                            <i class="bi bi-pencil me-1"></i> Edit Slide
                        </button>

                        <div class="d-flex gap-1">
                            <!-- Toggle Active/Inactive -->
                            <form method="post" asp-page-handler="ToggleSlide" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@slide.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-warning text-dark rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                        style="width: 34px; height: 34px;" title="Toggle Active / Inactive">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </form>

                            <!-- Delete Slide -->
                            <form method="post" asp-page-handler="DeleteSlide" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this hero slide?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@slide.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                        style="width: 34px; height: 34px;" title="Delete Slide">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add New Hero Slide -->
<div class="modal fade" id="addSlideModal" tabindex="-1" aria-labelledby="addSlideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="addSlideModalLabel"><i class="bi bi-cloud-arrow-up me-1 text-danger"></i> Add New Hero Banner Slide</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="AddSlide" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-image me-1 text-danger"></i> Slide Image Source</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option A: Upload Image File</label>
                                <input type="file" name="slideFile" class="form-control rounded-3" accept="image/*" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option B: Enter Image URL Link</label>
                                <input type="text" name="imageUrl" class="form-control rounded-3" placeholder="/images/banner1.jpg or https://..." />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Promotional Badge Text</label>
                            <input type="text" name="badgeText" class="form-control rounded-3" placeholder="e.g. ✨ Exclusive Eid Collection 2026" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Slide Headline Title <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. প্রতিদিনের সাজে, লমিসা মার্ট।" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Slide Subtitle / Description Text</label>
                        <textarea name="subtitle" class="form-control rounded-3" rows="2" placeholder="e.g. Everyday Elegance, Authentic Bangladeshi Craftsmanship."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Button Label Text</label>
                            <input type="text" name="buttonText" class="form-control rounded-3" placeholder="e.g. SHOP SAREES NOW" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Button Target Route / Link</label>
                            <input type="text" name="buttonLink" class="form-control rounded-3" placeholder="e.g. /category/saree" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Text Alignment</label>
                            <select name="textAlignment" class="form-select rounded-3">
                                <option value="left" selected>Left Aligned</option>
                                <option value="center">Center Aligned</option>
                                <option value="right">Right Aligned</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Display Order (Sort Sequence)</label>
                            <input type="number" name="sortOrder" class="form-control rounded-3" value="@(Model.SlidesList.Count + 1)" />
                        </div>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="button" class="btn btn-light rounded-pill me-2 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-cloud-arrow-up me-1"></i> Upload & Create Slide
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Hero Slide -->
<div class="modal fade" id="editSlideModal" tabindex="-1" aria-labelledby="editSlideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editSlideModalLabel"><i class="bi bi-pencil-square me-1 text-danger"></i> Edit Hero Slide & Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="EditSlide" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editSlideId" name="id" />

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-image me-1 text-danger"></i> Slide Image Source</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option A: Upload New Image File</label>
                                <input type="file" name="editSlideFile" class="form-control rounded-3" accept="image/*" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option B: Image URL Link</label>
                                <input type="text" id="editImageUrl" name="imageUrl" class="form-control rounded-3" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Promotional Badge Text</label>
                            <input type="text" id="editBadgeText" name="badgeText" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Slide Headline Title <span class="text-danger">*</span></label>
                            <input type="text" id="editTitle" name="title" class="form-control rounded-3" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Slide Subtitle / Description Text</label>
                        <textarea id="editSubtitle" name="subtitle" class="form-control rounded-3" rows="2"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Button Label Text</label>
                            <input type="text" id="editButtonText" name="buttonText" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Button Target Route / Link</label>
                            <input type="text" id="editButtonLink" name="buttonLink" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Text Alignment</label>
                            <select id="editTextAlignment" name="textAlignment" class="form-select rounded-3">
                                <option value="left">Left Aligned</option>
                                <option value="center">Center Aligned</option>
                                <option value="right">Right Aligned</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Display Order</label>
                            <input type="number" id="editSortOrder" name="sortOrder" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Slide Visibility</label>
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" id="editIsActive" name="isActive" value="true" />
                                <label class="form-check-label fw-bold text-dark small" for="editIsActive">Active Slide</label>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="button" class="btn btn-light rounded-pill me-2 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save Slide Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function populateEditSlideModal(id, img, badge, title, subtitle, btnText, btnLink, align, order, active) {
            document.getElementById('editSlideId').value = id;
            document.getElementById('editImageUrl').value = img;
            document.getElementById('editBadgeText').value = badge;
            document.getElementById('editTitle').value = title;
            document.getElementById('editSubtitle').value = subtitle;
            document.getElementById('editButtonText').value = btnText;
            document.getElementById('editButtonLink').value = btnLink;
            document.getElementById('editTextAlignment').value = align;
            document.getElementById('editSortOrder').value = order;
            document.getElementById('editIsActive').checked = active;
        }
    </script>
}
