@page "/Admin/UICustomization/Footer"
@model LamisaMart.Web.Pages.Admin.UICustomization.FooterModel
@{
    ViewData["Title"] = "Footer UI Customization - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Footer UI Customization</h3>
        <p class="text-muted small mb-0">Configure store summary text, social media channels, payment badges, and footer copyright notice.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-5">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="form-label fw-semibold small text-dark">Store Description & Heritage Summary</label>
                <textarea asp-for="FooterAboutText" class="form-control rounded-3" rows="3"></textarea>
            </div>

            <!-- Social Links -->
            <h6 class="fw-bold text-dark border-top pt-3 mb-3"><i class="bi bi-share me-1 text-primary"></i> Social Media Profiles & Channels</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small text-dark"><i class="bi bi-facebook me-1 text-primary"></i> Facebook Page URL</label>
                    <input type="text" asp-for="FacebookUrl" class="form-control rounded-3" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small text-dark"><i class="bi bi-instagram me-1 text-danger"></i> Instagram Profile URL</label>
                    <input type="text" asp-for="InstagramUrl" class="form-control rounded-3" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small text-dark"><i class="bi bi-youtube me-1 text-danger"></i> YouTube Channel URL</label>
                    <input type="text" asp-for="YoutubeUrl" class="form-control rounded-3" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small text-dark"><i class="bi bi-whatsapp me-1 text-success"></i> WhatsApp Support Number</label>
                    <input type="text" asp-for="WhatsappNumber" class="form-control rounded-3" />
                </div>
            </div>

            <!-- Footer Toggles -->
            <h6 class="fw-bold text-dark border-top pt-3 mb-3"><i class="bi bi-layout-south me-1 text-primary"></i> Footer Display Elements</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="ShowPaymentIconsBar" id="chkPayIcons" />
                        <label class="form-check-label small fw-bold text-dark" for="chkPayIcons">Show Accepted Payment Logos (bKash, Nagad, Visa, COD)</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="EnableNewsletterFooter" id="chkNews" />
                        <label class="form-check-label small fw-bold text-dark" for="chkNews">Show Email Newsletter Subscription Box in Footer</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-dark">Bottom Copyright Text Notice</label>
                <input type="text" asp-for="CopyrightText" class="form-control rounded-3" />
            </div>

            <div class="pt-4 border-top mt-4 text-end">
                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-floppy me-1"></i> Save Footer Customizations
                </button>
            </div>
        </form>
    </div>
</div>
