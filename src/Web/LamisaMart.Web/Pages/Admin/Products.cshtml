@page "/Admin/Products"
@model LamisaMart.Web.Pages.Admin.ProductsModel
@{
    ViewData["Title"] = "Catalog & Products - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Products Catalog Management</h3>
        <p class="text-muted small mb-0">Browse all published products, toggle featured homepage promotions, and inspect catalog items.</p>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Admin/Products" class="row g-2 align-items-center">
            <div class="col-12 col-md-8">
                <div class="d-flex gap-2 overflow-x-auto pb-1 scrollbar-hidden">
                    <a href="/Admin/Products" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(Model.CategoryFilter) ? "btn-dark fw-bold" : "btn-outline-secondary")">
                        All Categories
                    </a>
                    <a href="/Admin/Products?categoryFilter=Saree" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Saree" ? "btn-danger fw-bold" : "btn-outline-danger")">
                        Sarees
                    </a>
                    <a href="/Admin/Products?categoryFilter=Three Piece" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Three Piece" ? "btn-primary fw-bold" : "btn-outline-primary")">
                        Three Piece
                    </a>
                    <a href="/Admin/Products?categoryFilter=Kurti" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Kurti" ? "btn-success fw-bold" : "btn-outline-success")">
                        Kurtis
                    </a>
                    <a href="/Admin/Products?categoryFilter=Jewelry" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Jewelry" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")">
                        Jewelry
                    </a>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-0 py-2" placeholder="Search product name or vendor..." />
                    <button class="btn btn-outline-secondary bg-light border-0" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Product Info</th>
                    <th class="py-3">Category</th>
                    <th class="py-3">Vendor</th>
                    <th class="py-3 text-center">Rating</th>
                    <th class="py-3 text-center">Featured</th>
                    <th class="py-3 text-end">Price</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProductsList != null && Model.ProductsList.Any())
                {
                    foreach (var product in Model.ProductsList)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@product.ImageUrl" alt="@product.Name" class="rounded-3 object-fit-cover shadow-sm" style="width: 48px; height: 58px;" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 fs-7">@product.Name</h6>
                                        <span class="text-muted fs-7">Slug: /Product/@product.Slug</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fs-7">@product.CategoryName</span>
                            </td>
                            <td>
                                <span class="fw-medium text-dark fs-7"><i class="bi bi-shop me-1 text-primary"></i> @product.VendorName</span>
                            </td>
                            <td class="text-center fs-7">
                                <span class="text-warning me-1"><i class="bi bi-star-fill"></i></span>
                                <span class="fw-bold text-dark">@product.Rating.ToString("0.0")</span>
                                <span class="text-muted">(@product.ReviewCount)</span>
                            </td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="ToggleFeatured" class="d-inline">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    @if (product.IsFeatured)
                                    {
                                        <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 py-0 fs-7 shadow-sm">
                                            <i class="bi bi-star-fill me-1"></i> Featured
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0 fs-7">
                                            Promote
                                        </button>
                                    }
                                </form>
                            </td>
                            <td class="text-end fw-extrabold text-dark fs-6">
                                ৳ @product.BasePrice.ToString("N0")
                                @if (product.CompareAtPrice > product.BasePrice)
                                {
                                    <div class="text-muted text-decoration-line-through fs-7 fw-normal">৳ @product.CompareAtPrice.ToString("N0")</div>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <a href="/Product/@product.Slug" target="_blank" class="btn btn-sm btn-outline-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Preview Storefront">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam display-4 mb-2 d-block text-muted"></i>
                            <h6 class="fw-bold">No Products Found</h6>
                            <p class="small mb-0">Try clearing your filters or search terms.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
