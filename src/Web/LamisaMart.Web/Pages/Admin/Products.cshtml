@page "/Admin/Products"
@model LamisaMart.Web.Pages.Admin.ProductsModel
@{
    ViewData["Title"] = "Catalog & Products - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Products Catalog Management</h3>
        <p class="text-muted small mb-0">Browse all published products, add new items, edit details, toggle featured promotions, and manage catalog.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addProductModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Product
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Admin/Products" class="row g-2 align-items-center">
            <div class="col-12 col-md-8">
                <div class="d-flex gap-2 overflow-x-auto pb-1 scrollbar-hidden">
                    <a href="/Admin/Products" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(Model.CategoryFilter) ? "btn-dark fw-bold" : "btn-outline-secondary")">
                        All Categories
                    </a>
                    <a href="/Admin/Products?categoryFilter=Saree" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Saree" ? "btn-danger fw-bold" : "btn-outline-danger")">
                        Sarees
                    </a>
                    <a href="/Admin/Products?categoryFilter=Three Piece" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Three Piece" ? "btn-primary fw-bold" : "btn-outline-primary")">
                        Three Piece
                    </a>
                    <a href="/Admin/Products?categoryFilter=Kurti" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Kurti" ? "btn-success fw-bold" : "btn-outline-success")">
                        Kurtis
                    </a>
                    <a href="/Admin/Products?categoryFilter=Jewelry" class="btn btn-sm rounded-pill px-3 @(Model.CategoryFilter == "Jewelry" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")">
                        Jewelry
                    </a>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-0 py-2" placeholder="Search product name or vendor..." />
                    <button class="btn btn-outline-secondary bg-light border-0" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Product Info</th>
                    <th class="py-3">Category & Subcategory</th>
                    <th class="py-3">Brand & Vendor</th>
                    <th class="py-3 text-center">Featured</th>
                    <th class="py-3 text-end">Price</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProductsList != null && Model.ProductsList.Any())
                {
                    foreach (var product in Model.ProductsList)
                    {
                        var tagsJoined = string.Join(",", product.SelectedTags);
                        var attrJson = System.Text.Json.JsonSerializer.Serialize(product.SelectedAttributes);

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@product.ImageUrl" alt="@product.Name" class="rounded-3 object-fit-cover shadow-sm" style="width: 48px; height: 58px;" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 fs-7">@product.Name</h6>
                                        <span class="text-muted fs-7">Slug: /Product/@product.Slug</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fs-7">@product.CategoryName</span>
                                @if (!string.IsNullOrEmpty(product.SubCategoryName))
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle fs-7 ms-1">
                                        <i class="bi bi-diagram-2 me-1"></i>@product.SubCategoryName
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-danger fs-7 d-block">@product.BrandName</span>
                                <span class="text-muted fs-7"><i class="bi bi-shop me-1 text-primary"></i> @product.VendorName</span>
                            </td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="ToggleFeatured" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    @if (product.IsFeatured)
                                    {
                                        <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 py-0 fs-7 shadow-sm">
                                            <i class="bi bi-star-fill me-1"></i> Featured
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0 fs-7">
                                            Promote
                                        </button>
                                    }
                                </form>
                            </td>
                            <td class="text-end fw-extrabold text-dark fs-6">
                                ৳ @product.BasePrice.ToString("N0")
                                @if (product.CompareAtPrice > product.BasePrice)
                                {
                                    <div class="text-muted text-decoration-line-through fs-7 fw-normal">৳ @product.CompareAtPrice.ToString("N0")</div>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;"
                                            title="Edit Product Details"
                                            data-id="@product.Id"
                                            data-name="@product.Name"
                                            data-slug="@product.Slug"
                                            data-category="@product.CategoryName"
                                            data-subcategory="@(product.SubCategoryName ?? "")"
                                            data-brand="@product.BrandName"
                                            data-price="@product.BasePrice"
                                            data-compareprice="@product.CompareAtPrice"
                                            data-image="@product.ImageUrl"
                                            data-description="@product.Description"
                                            data-featured="@(product.IsFeatured ? "true" : "false")"
                                            data-enableattr="@(product.EnableAttributes ? "true" : "false")"
                                            data-tags="@tagsJoined"
                                            data-attributes='@attrJson'
                                            onclick="openEditProductModalFromData(this)">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <form method="post" asp-page-handler="DeleteProduct" class="d-inline" onsubmit="return confirm('Delete product &quot;@product.Name&quot;?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Delete Product">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>

                                    <a href="/Product/@product.Slug" target="_blank" class="btn btn-sm btn-outline-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Preview Storefront">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam display-4 mb-2 d-block text-muted"></i>
                            <h6 class="fw-bold">No Products Found</h6>
                            <p class="small mb-0">Try clearing your filters or search terms.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add New Product -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="addProductModalLabel">Add New Catalog Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="CreateProduct">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small text-dark">Product Title / Name <span class="text-danger">*</span></label>
                            <input type="text" name="productName" class="form-control rounded-3" placeholder="e.g. Handwoven Tangail Soft Cotton Saree" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Brand <span class="text-danger">*</span></label>
                            <select name="brandName" class="form-select rounded-3" required>
                                @foreach (var brand in Model.AvailableBrands)
                                {
                                    <option value="@brand.Name">@brand.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Main Category <span class="text-danger">*</span></label>
                            <select name="categoryName" id="addCategorySelect" class="form-select rounded-3" required onchange="filterAddSubcategories(this.value)">
                                @foreach (var cat in Model.AvailableCategories.Where(c => !c.IsSubCategory))
                                {
                                    <option value="@cat.Name">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Subcategory (Optional)</label>
                            <select name="subCategoryName" id="addSubCategorySelect" class="form-select rounded-3">
                                <option value="">-- None (Main Category Only) --</option>
                                @foreach (var subcat in Model.AvailableCategories.Where(c => c.IsSubCategory))
                                {
                                    <option value="@subcat.Name" data-parent="@subcat.ParentCategoryName">@subcat.Name (@subcat.ParentCategoryName)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Selling Price (BDT) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">৳</span>
                                <input type="number" name="basePrice" value="3650" step="50" class="form-control rounded-end-3" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Compare-At Price (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">৳</span>
                                <input type="number" name="comparePrice" value="4500" step="50" class="form-control rounded-end-3" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Primary Image URL <span class="text-danger">*</span></label>
                            <input type="text" name="imageUrl" class="form-control rounded-3" placeholder="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=800&q=80" value="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=800&q=80" required />
                            <div class="form-text fs-7">Enter direct HTTPS image URL or Unsplash CDN image link.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Product Tags Selection</label>
                            <div class="d-flex flex-wrap gap-2 p-2 bg-light rounded-3 border">
                                @foreach (var tag in Model.AvailableTags)
                                {
                                    <div class="form-check form-check-inline m-0">
                                        <input class="form-check-input" type="checkbox" name="selectedTags" value="@tag.Name" id="add_tag_@tag.Id" />
                                        <label class="form-check-label small fw-semibold" for="add_tag_@tag.Id">#@tag.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Dynamic Attributes Toggle & Options -->
                        <div class="col-12 border-top pt-3">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="enableAttributes" value="true" id="addEnableAttributesCheck" onchange="toggleAddAttributesBox(this.checked)" checked />
                                <label class="form-check-label fw-bold text-dark" for="addEnableAttributesCheck">Enable Product Variations & Dynamic Attributes</label>
                            </div>

                            <div id="addAttributesContainer" class="p-3 bg-light rounded-4 border">
                                <h6 class="fw-bold text-dark fs-7 mb-2"><i class="bi bi-sliders me-1 text-danger"></i> System Product Attributes Values</h6>
                                <p class="text-muted fs-7 mb-3">Select attribute values. Any new attribute created in the admin panel automatically appears below.</p>

                                <div class="row g-3">
                                    @foreach (var attr in Model.AvailableAttributes)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-7 text-dark">@attr.Name (@attr.Code)</label>
                                            <input type="hidden" name="attributeKeys" value="@attr.Code" />
                                            <select name="attributeValues" class="form-select form-select-sm rounded-3">
                                                <option value="">-- None Selected --</option>
                                                @foreach (var val in attr.Values)
                                                {
                                                    <option value="@val">@val</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Product Description & Specs</label>
                            <textarea name="description" class="form-control rounded-3" rows="3" placeholder="Exclusive pure handwoven cotton saree with intricate zari thread work..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="isFeaturedCheck" checked />
                                <label class="form-check-label fw-bold text-dark small" for="isFeaturedCheck">Promote on Storefront Homepage (Featured Badge)</label>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-top mt-3 text-end">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 me-2" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Publish Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Product -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editProductModalLabel">Edit Product Details & Attributes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="EditProduct">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" id="editProductId" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small text-dark">Product Title / Name <span class="text-danger">*</span></label>
                            <input type="text" name="productName" id="editProductName" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Brand <span class="text-danger">*</span></label>
                            <select name="brandName" id="editProductBrand" class="form-select rounded-3" required>
                                @foreach (var brand in Model.AvailableBrands)
                                {
                                    <option value="@brand.Name">@brand.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Main Category <span class="text-danger">*</span></label>
                            <select name="categoryName" id="editProductCategory" class="form-select rounded-3" required>
                                @foreach (var cat in Model.AvailableCategories.Where(c => !c.IsSubCategory))
                                {
                                    <option value="@cat.Name">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Subcategory (Optional)</label>
                            <select name="subCategoryName" id="editProductSubCategory" class="form-select rounded-3">
                                <option value="">-- None (Main Category Only) --</option>
                                @foreach (var subcat in Model.AvailableCategories.Where(c => c.IsSubCategory))
                                {
                                    <option value="@subcat.Name">@subcat.Name (@subcat.ParentCategoryName)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">URL Route Slug</label>
                            <input type="text" name="slug" id="editProductSlug" class="form-control rounded-3" placeholder="dhakai-jamdani-saree" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Selling Price (BDT) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">৳</span>
                                <input type="number" name="basePrice" id="editProductPrice" step="50" class="form-control rounded-end-3" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Compare-At Price (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">৳</span>
                                <input type="number" name="comparePrice" id="editProductComparePrice" step="50" class="form-control rounded-end-3" />
                            </div>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-semibold small text-dark">Primary Image URL <span class="text-danger">*</span></label>
                            <input type="text" name="imageUrl" id="editProductImageUrl" class="form-control rounded-3" required oninput="previewEditProductImg(this.value)" />
                        </div>
                        <div class="col-md-4 text-center">
                            <span class="d-block small text-muted mb-1">Image Preview:</span>
                            <img id="editProductPreviewImg" src="" alt="Preview" class="rounded-3 object-fit-cover shadow-sm border" style="width: 60px; height: 75px;" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Product Tags Selection</label>
                            <div class="d-flex flex-wrap gap-2 p-2 bg-light rounded-3 border" id="editTagsContainer">
                                @foreach (var tag in Model.AvailableTags)
                                {
                                    <div class="form-check form-check-inline m-0">
                                        <input class="form-check-input edit-tag-check" type="checkbox" name="selectedTags" value="@tag.Name" id="edit_tag_@tag.Id" />
                                        <label class="form-check-label small fw-semibold" for="edit_tag_@tag.Id">#@tag.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Dynamic Attributes Toggle & Options -->
                        <div class="col-12 border-top pt-3">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="enableAttributes" value="true" id="editProductEnableAttributes" onchange="toggleEditAttributesBox(this.checked)" />
                                <label class="form-check-label fw-bold text-dark" for="editProductEnableAttributes">Enable Product Variations & Dynamic Attributes</label>
                            </div>

                            <div id="editAttributesContainer" class="p-3 bg-light rounded-4 border">
                                <h6 class="fw-bold text-dark fs-7 mb-2"><i class="bi bi-sliders me-1 text-danger"></i> System Product Attributes Values</h6>
                                <p class="text-muted fs-7 mb-3">Select attribute values. Any new attribute created in the admin panel automatically appears below.</p>

                                <div class="row g-3">
                                    @foreach (var attr in Model.AvailableAttributes)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-7 text-dark">@attr.Name (@attr.Code)</label>
                                            <input type="hidden" name="attributeKeys" value="@attr.Code" />
                                            <select name="attributeValues" id="edit_attr_@attr.Code" class="form-select form-select-sm rounded-3 edit-attr-select">
                                                <option value="">-- None Selected --</option>
                                                @foreach (var val in attr.Values)
                                                {
                                                    <option value="@val">@val</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Product Description & Specs</label>
                            <textarea name="description" id="editProductDescription" class="form-control rounded-3" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="editProductIsFeatured" />
                                <label class="form-check-label fw-bold text-dark small" for="editProductIsFeatured">Promote on Storefront Homepage (Featured Badge)</label>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-top mt-3 text-end">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 me-2" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAddAttributesBox(enabled) {
            const container = document.getElementById('addAttributesContainer');
            if (container) {
                container.style.display = enabled ? 'block' : 'none';
            }
        }

        function toggleEditAttributesBox(enabled) {
            const container = document.getElementById('editAttributesContainer');
            if (container) {
                container.style.display = enabled ? 'block' : 'none';
            }
        }

        function openEditProductModalFromData(btn) {
            const id = btn.getAttribute('data-id') || '';
            const name = btn.getAttribute('data-name') || '';
            const slug = btn.getAttribute('data-slug') || '';
            const category = btn.getAttribute('data-category') || 'Saree';
            const subcategory = btn.getAttribute('data-subcategory') || '';
            const brand = btn.getAttribute('data-brand') || 'Lamisa Heritage';
            const price = btn.getAttribute('data-price') || '0';
            const comparePrice = btn.getAttribute('data-compareprice') || '0';
            const image = btn.getAttribute('data-image') || '';
            const description = btn.getAttribute('data-description') || '';
            const isFeatured = btn.getAttribute('data-featured') === 'true';
            const enableAttr = btn.getAttribute('data-enableattr') === 'true';
            const tagsStr = btn.getAttribute('data-tags') || '';
            const attrJson = btn.getAttribute('data-attributes') || '{}';

            document.getElementById('editProductId').value = id;
            document.getElementById('editProductName').value = name;
            document.getElementById('editProductSlug').value = slug;
            document.getElementById('editProductCategory').value = category;
            document.getElementById('editProductSubCategory').value = subcategory;
            document.getElementById('editProductBrand').value = brand;
            document.getElementById('editProductPrice').value = price;
            document.getElementById('editProductComparePrice').value = comparePrice;
            document.getElementById('editProductImageUrl').value = image;
            document.getElementById('editProductDescription').value = description;
            document.getElementById('editProductIsFeatured').checked = isFeatured;

            // Enable Attributes Switch & Container
            const enableCheck = document.getElementById('editProductEnableAttributes');
            enableCheck.checked = enableAttr;
            toggleEditAttributesBox(enableAttr);

            // Tags Checkboxes
            const tagArray = tagsStr.split(',').map(t => t.trim());
            document.querySelectorAll('.edit-tag-check').forEach(chk => {
                chk.checked = tagArray.includes(chk.value);
            });

            // Attributes Selects
            try {
                const attrObj = JSON.parse(attrJson);
                document.querySelectorAll('.edit-attr-select').forEach(select => {
                    const code = select.id.replace('edit_attr_', '');
                    if (attrObj && attrObj[code]) {
                        select.value = attrObj[code];
                    } else {
                        select.value = '';
                    }
                });
            } catch (e) {}

            previewEditProductImg(image);

            const modal = new bootstrap.Modal(document.getElementById('editProductModal'));
            modal.show();
        }

        function previewEditProductImg(url) {
            const img = document.getElementById('editProductPreviewImg');
            if (img) {
                img.src = url || 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=500&q=80';
            }
        }
    </script>
}
