@page "/Admin/Orders"
@model LamisaMart.Web.Pages.Admin.OrdersModel
@{
    ViewData["Title"] = "Order Management - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Platform Orders Management</h3>
        <p class="text-muted small mb-0">Monitor customer orders, track multi-vendor fulfillment, and update delivery statuses.</p>
    </div>
</div>

<!-- Status Filter Tabs & Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Admin/Orders" class="row g-2 align-items-center">
            <div class="col-12 col-md-8">
                <div class="d-flex gap-2 overflow-x-auto pb-1 scrollbar-hidden">
                    <a href="/Admin/Orders" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(Model.StatusFilter) ? "btn-dark fw-bold" : "btn-outline-secondary")">
                        All Orders
                    </a>
                    <a href="/Admin/Orders?statusFilter=Pending" class="btn btn-sm rounded-pill px-3 @(Model.StatusFilter == "Pending" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")">
                        Pending
                    </a>
                    <a href="/Admin/Orders?statusFilter=Processing" class="btn btn-sm rounded-pill px-3 @(Model.StatusFilter == "Processing" ? "btn-info text-white fw-bold" : "btn-outline-info")">
                        Processing
                    </a>
                    <a href="/Admin/Orders?statusFilter=Shipped" class="btn btn-sm rounded-pill px-3 @(Model.StatusFilter == "Shipped" ? "btn-primary fw-bold" : "btn-outline-primary")">
                        Shipped
                    </a>
                    <a href="/Admin/Orders?statusFilter=Delivered" class="btn btn-sm rounded-pill px-3 @(Model.StatusFilter == "Delivered" ? "btn-success fw-bold" : "btn-outline-success")">
                        Delivered
                    </a>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-0 py-2" placeholder="Search Order #, customer or phone..." />
                    <button class="btn btn-outline-secondary bg-light border-0" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Order #</th>
                    <th class="py-3">Customer Details</th>
                    <th class="py-3">City</th>
                    <th class="py-3">Items</th>
                    <th class="py-3">Payment Method</th>
                    <th class="py-3 text-center">Paid Status</th>
                    <th class="py-3 text-center">Order Status</th>
                    <th class="py-3 text-end">Total Amount</th>
                    <th class="pe-4 py-3 text-end">Update Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrdersList != null && Model.OrdersList.Any())
                {
                    foreach (var order in Model.OrdersList)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark fs-7">@order.OrderNumber</div>
                                <span class="text-muted fs-7"><i class="bi bi-clock me-1"></i> @order.CreatedAt.ToString("MMM dd, HH:mm")</span>
                            </td>
                            <td>
                                <div class="fw-medium text-dark fs-7">@order.CustomerName</div>
                                <span class="text-muted fs-7"><i class="bi bi-telephone me-1"></i> @order.CustomerPhone</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fs-7">@order.ShippingCity</span>
                            </td>
                            <td class="fs-7 fw-semibold text-dark">
                                @order.ItemCount Items
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border fw-bold fs-7">@order.PaymentMethod</span>
                            </td>
                            <td class="text-center">
                                @if (order.IsPaid)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-7">
                                        <i class="bi bi-check-circle-fill me-1"></i> Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill fs-7">
                                        Unpaid
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Delivered)
                                {
                                    <span class="badge bg-success shadow-sm rounded-pill px-3 py-1">Delivered</span>
                                }
                                else if (order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Shipped)
                                {
                                    <span class="badge bg-primary shadow-sm rounded-pill px-3 py-1">Shipped</span>
                                }
                                else if (order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Processing || order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Confirmed)
                                {
                                    <span class="badge bg-warning text-dark shadow-sm rounded-pill px-3 py-1">Processing</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-1">@order.Status</span>
                                }
                            </td>
                            <td class="text-end fw-extrabold text-dark fs-6">
                                ৳ @order.TotalAmount.ToString("N0")
                            </td>
                            <td class="pe-4 text-end">
                                <form method="post" asp-page-handler="UpdateStatus" class="d-inline-flex gap-1">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <select name="newStatus" class="form-select form-select-sm border-secondary-subtle" style="width: auto;" onchange="this.form.submit()">
                                        <option value="">Set Status...</option>
                                        <option value="Confirmed" selected="@(order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Confirmed)">Confirmed</option>
                                        <option value="Processing" selected="@(order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Processing)">Processing</option>
                                        <option value="Shipped" selected="@(order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Shipped)">Shipped</option>
                                        <option value="Delivered" selected="@(order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Delivered)">Delivered</option>
                                        <option value="Cancelled" selected="@(order.Status == LamisaMart.Ordering.Domain.Entities.OrderStatus.Cancelled)">Cancelled</option>
                                    </select>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam display-4 mb-2 d-block text-muted"></i>
                            <h6 class="fw-bold">No Orders Found</h6>
                            <p class="small mb-0">Try clearing your filters or searching for another order number.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
