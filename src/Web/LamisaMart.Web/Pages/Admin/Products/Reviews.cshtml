@page "/Admin/Products/Reviews"
@model LamisaMart.Web.Pages.Admin.Products.ReviewsModel
@{
    ViewData["Title"] = "Customer Product Reviews - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Customer Product Reviews Moderation</h3>
        <p class="text-muted small mb-0">Approve verified customer feedback, monitor star ratings, and delete spam reviews.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Admin/Products/Reviews" class="row g-2 align-items-center">
            <div class="col-12 col-md-6 ms-auto">
                <div class="input-group input-group-sm">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-0 py-2" placeholder="Search product, customer or review text..." />
                    <button class="btn btn-outline-secondary bg-light border-0" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Product Name</th>
                    <th class="py-3">Customer</th>
                    <th class="py-3 text-center">Rating</th>
                    <th class="py-3">Comment Review</th>
                    <th class="py-3 text-center">Status</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rev in Model.ReviewsList)
                {
                    <tr>
                        <td class="ps-4" style="max-width: 220px;">
                            <h6 class="fw-bold text-dark mb-0 fs-7 text-truncate">@rev.ProductName</h6>
                            <span class="text-muted fs-7">@rev.CreatedAt.ToString("MMM dd, HH:mm")</span>
                        </td>
                        <td>
                            <div class="fw-medium text-dark fs-7">@rev.CustomerName</div>
                            @if (rev.IsVerifiedPurchase)
                            {
                                <span class="badge bg-success-subtle text-success fs-7 border border-success-subtle">
                                    <i class="bi bi-patch-check-fill me-1"></i> Verified Buyer
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="text-warning fs-7">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= rev.Rating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-muted"></i>
                                    }
                                }
                            </div>
                            <span class="fw-bold text-dark fs-7">@rev.Rating / 5</span>
                        </td>
                        <td style="max-width: 280px;">
                            <p class="mb-0 fs-7 text-secondary">"@rev.Comment"</p>
                        </td>
                        <td class="text-center">
                            @if (rev.IsApproved)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">Pending Approval</span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-1">
                                @if (!rev.IsApproved)
                                {
                                    <form method="post" asp-page-handler="Approve" class="d-inline">
                                        <input type="hidden" name="reviewId" value="@rev.Id" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-bold fs-7 shadow-sm">
                                            <i class="bi bi-check-lg me-1"></i> Approve
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Delete this review?');">
                                    <input type="hidden" name="reviewId" value="@rev.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Delete Review">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
