@page "/Admin/Products/Attributes"
@model LamisaMart.Web.Pages.Admin.Products.AttributesModel
@{
    ViewData["Title"] = "Product Attributes - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Product Attributes Management</h3>
        <p class="text-muted small mb-0">Define product variation attributes e.g., Color, Fabric Material, Size, & Weave Count.</p>
    </div>
    <div>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addAttributeModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Attribute
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Admin/Products/Attributes" class="row g-2 align-items-center">
            <div class="col-12 col-md-6 ms-auto">
                <div class="input-group input-group-sm">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-0 py-2" placeholder="Search attribute..." />
                    <button class="btn btn-outline-secondary bg-light border-0" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Attribute Name</th>
                    <th class="py-3">Code Key</th>
                    <th class="py-3">Sample Values</th>
                    <th class="py-3 text-center">Products Using</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attr in Model.AttributesList)
                {
                    var joinedValues = string.Join(", ", attr.Values);
                    <tr>
                        <td class="ps-4">
                            <h6 class="fw-bold text-dark mb-0 fs-7">@attr.Name</h6>
                        </td>
                        <td class="fs-7"><code class="text-primary">@attr.Code</code></td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                @foreach (var val in attr.Values.Take(4))
                                {
                                    <span class="badge bg-light text-dark border fs-7">@val</span>
                                }
                                @if (attr.Values.Count > 4)
                                {
                                    <span class="badge bg-secondary-subtle text-muted fs-7">+@(attr.Values.Count - 4) more</span>
                                }
                            </div>
                        </td>
                        <td class="text-center fw-bold text-dark fs-7">@attr.ProductCount Items</td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" 
                                        title="Edit Attribute"
                                        data-id="@attr.Id"
                                        data-name="@attr.Name"
                                        data-code="@attr.Code"
                                        data-values="@joinedValues"
                                        onclick="openEditAttributeModalFromData(this)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Delete this attribute?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="attributeId" value="@attr.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Delete Attribute">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add Attribute -->
<div class="modal fade" id="addAttributeModal" tabindex="-1" aria-labelledby="addAttributeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="addAttributeModalLabel">Add New Product Attribute</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="CreateAttribute">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Attribute Title <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control rounded-3" placeholder="e.g. Embroidery Work Type" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Code Identifier</label>
                        <input type="text" name="code" class="form-control rounded-3" placeholder="e.g. embroidery_type" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Preset Values (Comma Separated)</label>
                        <textarea name="values" class="form-control rounded-3" rows="2" placeholder="Zardozi, Schiffli, Kundan, Kantha Stitch"></textarea>
                    </div>
                    <div class="pt-3">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Save Attribute
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Attribute -->
<div class="modal fade" id="editAttributeModal" tabindex="-1" aria-labelledby="editAttributeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editAttributeModalLabel">Edit Product Attribute</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="EditAttribute">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="attributeId" id="editAttributeId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Attribute Title <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editAttributeName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Code Identifier</label>
                        <input type="text" name="code" id="editAttributeCode" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Preset Values (Comma Separated)</label>
                        <textarea name="values" id="editAttributeValues" class="form-control rounded-3" rows="3"></textarea>
                    </div>
                    <div class="pt-3">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditAttributeModalFromData(btn) {
            const id = btn.getAttribute('data-id') || '';
            const name = btn.getAttribute('data-name') || '';
            const code = btn.getAttribute('data-code') || '';
            const values = btn.getAttribute('data-values') || '';

            document.getElementById('editAttributeId').value = id;
            document.getElementById('editAttributeName').value = name;
            document.getElementById('editAttributeCode').value = code;
            document.getElementById('editAttributeValues').value = values;

            const modal = new bootstrap.Modal(document.getElementById('editAttributeModal'));
            modal.show();
        }
    </script>
}
