@page "/Admin/Products/Brands"
@model LamisaMart.Web.Pages.Admin.Products.BrandsModel
@{
    ViewData["Title"] = "Brand Management & Vendor Authorizations - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Brand Management & Vendor Authorizations</h3>
        <p class="text-muted small mb-0">Manage product brands, upload brand logos, and authorize vendors to list products under specific brand licenses.</p>
    </div>
    <div>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createBrandModal">
            <i class="bi bi-plus-circle me-1"></i> Add New Brand
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" asp-for="SearchQuery" class="form-control rounded-pill ps-5" placeholder="Search brands by name or slug..." />
                </div>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-dark rounded-pill px-4 w-100 fw-semibold">Search</button>
            </div>
        </form>
    </div>
</div>

<!-- Brands Data Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light border-bottom">
                <tr>
                    <th class="ps-4 py-3 text-muted small fw-bold">BRAND LOGO & NAME</th>
                    <th class="py-3 text-muted small fw-bold">SLUG</th>
                    <th class="py-3 text-muted small fw-bold">PRODUCTS</th>
                    <th class="py-3 text-muted small fw-bold">AUTHORIZED VENDORS</th>
                    <th class="py-3 text-muted small fw-bold">FEATURED</th>
                    <th class="py-3 text-muted small fw-bold text-end pe-4">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var brand in Model.BrandsList)
                {
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@brand.LogoUrl" alt="@brand.Name" class="rounded-3 border object-fit-cover p-1 bg-white shadow-sm" style="width: 44px; height: 44px;" onerror="this.src='https://via.placeholder.com/44'" />
                                <div>
                                    <div class="fw-bold text-dark fs-6">@brand.Name</div>
                                    <small class="text-muted extra-small">Added @brand.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                        </td>
                        <td><code class="text-danger fw-bold fs-8">@brand.Slug</code></td>
                        <td><span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1.5 fw-bold fs-8">@brand.ProductCount Products</span></td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var vendor in brand.AuthorizedVendors)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8">@vendor</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (brand.IsFeatured)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fs-8"><i class="bi bi-star-fill me-1"></i> Featured</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1 fs-8">Standard</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1 fw-semibold"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editBrandModal"
                                    onclick="populateEditBrandModal('@brand.Id', '@brand.Name', '@brand.Slug', '@brand.LogoUrl', @(brand.IsFeatured ? "true" : "false"), ['@string.Join("','", brand.AuthorizedVendors)'])">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </button>
                            <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete brand @brand.Name?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="brandId" value="@brand.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width:32px; height:32px;" title="Delete Brand">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Brand -->
<div class="modal fade" id="createBrandModal" tabindex="-1" aria-labelledby="createBrandModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createBrandModalLabel"><i class="bi bi-plus-circle me-1 text-danger"></i> Add New Product Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="CreateBrand" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" name="brandName" class="form-control rounded-3" placeholder="e.g. Lamisa Artisanal Saree" required />
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-image me-1 text-danger"></i> Brand Logo Image Source</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option A: Upload Logo File</label>
                                <input type="file" name="brandLogoFile" class="form-control rounded-3" accept="image/*" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option B: Enter Image URL</label>
                                <input type="text" name="logoUrl" class="form-control rounded-3" placeholder="/images/logo.png or https://..." />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark mb-2">Authorize Vendors for this Brand</label>
                        <div class="row g-2 bg-light p-3 rounded-3 border" style="max-height: 160px; overflow-y: auto;">
                            @foreach (var v in Model.AvailableVendors)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedVendors" value="@v.Name" id="v_create_@v.Id" />
                                        <label class="form-check-label small fw-semibold text-dark cursor-pointer" for="v_create_@v.Id">@v.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="chkFeaturedCreate" />
                        <label class="form-check-label fw-bold text-dark small" for="chkFeaturedCreate">Feature this Brand on Storefront Homepage</label>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="button" class="btn btn-light rounded-pill me-2 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-cloud-arrow-up me-1"></i> Upload & Create Brand
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Brand -->
<div class="modal fade" id="editBrandModal" tabindex="-1" aria-labelledby="editBrandModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editBrandModalLabel"><i class="bi bi-pencil-square me-1 text-danger"></i> Edit Brand & Authorized Vendors</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="EditBrand" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editBrandId" name="brandId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Brand Name <span class="text-danger">*</span></label>
                            <input type="text" id="editBrandName" name="brandName" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Brand Slug</label>
                            <input type="text" id="editBrandSlug" name="slug" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-image me-1 text-danger"></i> Brand Logo Image Source</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option A: Upload New Logo File</label>
                                <input type="file" name="editBrandLogoFile" class="form-control rounded-3" accept="image/*" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Option B: Image URL</label>
                                <input type="text" id="editLogoUrl" name="logoUrl" class="form-control rounded-3" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark mb-2">Authorize Vendors for this Brand</label>
                        <div class="row g-2 bg-light p-3 rounded-3 border" style="max-height: 160px; overflow-y: auto;">
                            @foreach (var v in Model.AvailableVendors)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input v-edit-chk" type="checkbox" name="selectedVendors" value="@v.Name" id="v_edit_@v.Id" />
                                        <label class="form-check-label small fw-semibold text-dark cursor-pointer" for="v_edit_@v.Id">@v.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="editIsFeatured" name="isFeatured" value="true" />
                        <label class="form-check-label fw-bold text-dark small" for="editIsFeatured">Feature this Brand on Storefront Homepage</label>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="button" class="btn btn-light rounded-pill me-2 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save Brand Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function populateEditBrandModal(id, name, slug, logo, featured, vendors) {
            document.getElementById('editBrandId').value = id;
            document.getElementById('editBrandName').value = name;
            document.getElementById('editBrandSlug').value = slug;
            document.getElementById('editLogoUrl').value = logo;
            document.getElementById('editIsFeatured').checked = featured;

            document.querySelectorAll('.v-edit-chk').forEach(chk => {
                chk.checked = vendors.includes(chk.value);
            });
        }
    </script>
}
