@page "/Admin/Products/Brands"
@model LamisaMart.Web.Pages.Admin.Products.BrandsModel
@{
    ViewData["Title"] = "Product Brands - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Product Brands Management</h3>
        <p class="text-muted small mb-0">Create brands, set featured homepage logos, and organize brand catalogs.</p>
    </div>
    <div>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addBrandModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Brand
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Admin/Products/Brands" class="row g-2 align-items-center">
            <div class="col-12 col-md-6 ms-auto">
                <div class="input-group input-group-sm">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-0 py-2" placeholder="Search brand name..." />
                    <button class="btn btn-outline-secondary bg-light border-0" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Brand Logo & Name</th>
                    <th class="py-3">Slug Route</th>
                    <th class="py-3 text-center">Products Count</th>
                    <th class="py-3 text-center">Featured</th>
                    <th class="py-3">Created Date</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var brand in Model.BrandsList)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@brand.LogoUrl" alt="@brand.Name" class="rounded-circle object-fit-cover shadow-sm" style="width: 44px; height: 44px;" />
                                <div>
                                    <h6 class="fw-bold text-dark mb-0 fs-7">@brand.Name</h6>
                                </div>
                            </div>
                        </td>
                        <td class="fs-7 text-muted">/brand/@brand.Slug</td>
                        <td class="text-center fw-bold text-dark fs-7">@brand.ProductCount Items</td>
                        <td class="text-center">
                            <form method="post" asp-page-handler="ToggleFeatured" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="brandId" value="@brand.Id" />
                                @if (brand.IsFeatured)
                                {
                                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 py-0 fs-7 shadow-sm">
                                        <i class="bi bi-star-fill me-1"></i> Featured
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0 fs-7">
                                        Standard
                                    </button>
                                }
                            </form>
                        </td>
                        <td class="fs-7 text-muted">@brand.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" 
                                        title="Edit Brand & Logo"
                                        data-id="@brand.Id"
                                        data-name="@brand.Name"
                                        data-slug="@brand.Slug"
                                        data-logo="@brand.LogoUrl"
                                        data-featured="@(brand.IsFeatured ? "true" : "false")"
                                        onclick="openEditBrandModalFromData(this)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Delete this brand?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="brandId" value="@brand.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Delete Brand">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add Brand -->
<div class="modal fade" id="addBrandModal" tabindex="-1" aria-labelledby="addBrandModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="addBrandModalLabel">Add New Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="CreateBrand">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" name="brandName" class="form-control rounded-3" placeholder="e.g. Tangail Weavers Collection" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Brand Logo URL</label>
                        <input type="text" name="logoUrl" class="form-control rounded-3" placeholder="https://images.unsplash.com/..." value="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=150&q=80" />
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="isFeaturedCheck" checked />
                        <label class="form-check-label fw-bold text-dark small" for="isFeaturedCheck">Feature Brand on Homepage</label>
                    </div>
                    <div class="pt-3">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Save Brand
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Brand -->
<div class="modal fade" id="editBrandModal" tabindex="-1" aria-labelledby="editBrandModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editBrandModalLabel">Edit Brand & Logo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="EditBrand">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="brandId" id="editBrandId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" name="brandName" id="editBrandName" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">URL Route Slug</label>
                        <input type="text" name="slug" id="editBrandSlug" class="form-control rounded-3" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Brand Logo URL <span class="text-danger">*</span></label>
                        <input type="text" name="logoUrl" id="editBrandLogoUrl" class="form-control rounded-3" placeholder="https://images.unsplash.com/..." required oninput="previewEditLogo(this.value)" />
                    </div>

                    <!-- Live Logo Preview Box -->
                    <div class="mb-3 text-center bg-light p-2 rounded-3 border">
                        <span class="d-block small text-muted mb-1">Logo Preview:</span>
                        <img id="editBrandPreviewImg" src="" alt="Preview" class="rounded-circle object-fit-cover shadow-sm" style="width: 80px; height: 80px;" />
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="editBrandIsFeaturedCheck" />
                        <label class="form-check-label fw-bold text-dark small" for="editBrandIsFeaturedCheck">Feature Brand on Homepage</label>
                    </div>

                    <div class="pt-3">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditBrandModalFromData(btn) {
            const id = btn.getAttribute('data-id') || '';
            const name = btn.getAttribute('data-name') || '';
            const slug = btn.getAttribute('data-slug') || '';
            const logoUrl = btn.getAttribute('data-logo') || '';
            const isFeatured = btn.getAttribute('data-featured') === 'true';

            document.getElementById('editBrandId').value = id;
            document.getElementById('editBrandName').value = name;
            document.getElementById('editBrandSlug').value = slug;
            document.getElementById('editBrandLogoUrl').value = logoUrl;
            document.getElementById('editBrandIsFeaturedCheck').checked = isFeatured;

            previewEditLogo(logoUrl);

            const modal = new bootstrap.Modal(document.getElementById('editBrandModal'));
            modal.show();
        }

        function previewEditLogo(url) {
            const img = document.getElementById('editBrandPreviewImg');
            if (img) {
                img.src = url || 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=150&q=80';
            }
        }
    </script>
}
