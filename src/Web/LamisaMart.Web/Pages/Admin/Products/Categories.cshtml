@page "/Admin/Products/Categories"
@model LamisaMart.Web.Pages.Admin.Products.CategoriesModel
@{
    ViewData["Title"] = "Product Categories - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Product Category Management</h3>
        <p class="text-muted small mb-0">Manage catalog categories, change banner pictures, feature items, and edit URL slugs.</p>
    </div>
    <div>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Category
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Admin/Products/Categories" class="row g-2 align-items-center">
            <div class="col-12 col-md-6 ms-auto">
                <div class="input-group input-group-sm">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-0 py-2" placeholder="Search category..." />
                    <button class="btn btn-outline-secondary bg-light border-0" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">Category Name</th>
                    <th class="py-3">URL Route Slug</th>
                    <th class="py-3 text-center">Products</th>
                    <th class="py-3 text-center">Featured</th>
                    <th class="py-3 text-center">Status</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.CategoriesList)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@cat.ImageUrl" alt="@cat.Name" class="rounded-3 object-fit-cover shadow-sm" style="width: 44px; height: 44px;" />
                                <h6 class="fw-bold text-dark mb-0 fs-7">@cat.Name</h6>
                            </div>
                        </td>
                        <td class="fs-7 text-muted">/category/@cat.Slug</td>
                        <td class="text-center fw-bold text-dark fs-7">@cat.ProductCount Items</td>
                        <td class="text-center">
                            @if (cat.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark fw-bold rounded-pill">Featured</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border rounded-pill">Standard</span>
                            }
                        </td>
                        <td class="text-center">
                            <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                <input type="hidden" name="categoryId" value="@cat.Id" />
                                @if (cat.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-success-subtle text-success border border-success-subtle rounded-pill px-3 py-0 fs-7">Active</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-secondary-subtle text-secondary border rounded-pill px-2 py-0 fs-7">Disabled</button>
                                }
                            </form>
                        </td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" 
                                        title="Edit Category & Change Picture"
                                        onclick="openEditCategoryModal('@cat.Id', '@cat.Name', '@cat.Slug', '@cat.ImageUrl', @(cat.IsFeatured ? "true" : "false"))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <a href="/category/@cat.Slug" target="_blank" class="btn btn-sm btn-outline-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="View Storefront Category">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add Category -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="addCategoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" action="/Admin/Products/Categories?handler=CreateCategory">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="categoryName" class="form-control rounded-3" placeholder="e.g. Wedding Jamdani" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Category Banner Image URL</label>
                        <input type="text" name="imageUrl" class="form-control rounded-3" placeholder="https://images.unsplash.com/..." value="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=500&q=80" />
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="catFeaturedCheck" checked />
                        <label class="form-check-label fw-bold text-dark small" for="catFeaturedCheck">Promote on Storefront Navigation Bar</label>
                    </div>
                    <div class="pt-3">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Save Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Category (Change Picture & Properties) -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editCategoryModalLabel">Edit Category & Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" action="/Admin/Products/Categories?handler=EditCategory">
                    <input type="hidden" name="categoryId" id="editCategoryId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="categoryName" id="editCategoryName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">URL Route Slug</label>
                        <input type="text" name="slug" id="editCategorySlug" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Category Picture Image URL <span class="text-danger">*</span></label>
                        <input type="text" name="imageUrl" id="editCategoryImageUrl" class="form-control rounded-3" placeholder="https://images.unsplash.com/..." required oninput="previewEditImage(this.value)" />
                        <div class="form-text fs-7">Enter direct image link (e.g. Unsplash CDN or direct image URL).</div>
                    </div>
                    
                    <!-- Live Image Preview Box -->
                    <div class="mb-3 text-center bg-light p-2 rounded-3 border">
                        <span class="d-block small text-muted mb-1">Image Preview:</span>
                        <img id="editCategoryPreviewImg" src="" alt="Preview" class="rounded-3 object-fit-cover shadow-sm" style="width: 120px; height: 120px;" />
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="editIsFeaturedCheck" />
                        <label class="form-check-label fw-bold text-dark small" for="editIsFeaturedCheck">Promote on Storefront Navigation Bar</label>
                    </div>

                    <div class="pt-3">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditCategoryModal(id, name, slug, imageUrl, isFeatured) {
            document.getElementById('editCategoryId').value = id;
            document.getElementById('editCategoryName').value = name;
            document.getElementById('editCategorySlug').value = slug;
            document.getElementById('editCategoryImageUrl').value = imageUrl;
            document.getElementById('editIsFeaturedCheck').checked = isFeatured;

            previewEditImage(imageUrl);

            const modal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
            modal.show();
        }

        function previewEditImage(url) {
            const img = document.getElementById('editCategoryPreviewImg');
            if (img) {
                img.src = url || 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=300&q=80';
            }
        }
    </script>
}
