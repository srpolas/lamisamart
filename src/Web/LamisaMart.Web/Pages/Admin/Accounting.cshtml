@page "/Admin/Accounting"
@model LamisaMart.Web.Pages.Admin.AccountingModel
@{
    ViewData["Title"] = "Accounting & Ledger - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Double-Entry Accounting & Vendor Payouts</h3>
        <p class="text-muted small mb-0">Platform commission tracking, general ledger accounts, and vendor payout settlements.</p>
    </div>
    <div>
        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#payoutModal">
            <i class="bi bi-wallet-fill me-1"></i> Initiate Vendor Payout
        </button>
    </div>
</div>

@if (TempData["PayoutSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["PayoutSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Financial Overview KPI Row -->
<div class="row g-3 g-md-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 card-stat border-start border-4 border-success">
            <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Gross Volume (GMV)</span>
            <h3 class="fw-bold text-dark mt-2 mb-1">৳ @Model.TotalGMV.ToString("N0")</h3>
            <span class="text-muted fs-7">Total Sales across all stores</span>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 card-stat border-start border-4 border-primary">
            <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Platform Commission (8%)</span>
            <h3 class="fw-bold text-primary mt-2 mb-1">৳ @Model.TotalCommissionEarned.ToString("N0")</h3>
            <span class="text-success fs-7 fw-semibold"><i class="bi bi-arrow-up-right me-1"></i> Net Earned Revenue</span>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 card-stat border-start border-4 border-info">
            <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Disbursed Payouts</span>
            <h3 class="fw-bold text-dark mt-2 mb-1">৳ @Model.PayoutsDisbursed.ToString("N0")</h3>
            <span class="text-muted fs-7">Settled to Vendor Bank/bKash</span>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 card-stat border-start border-4 border-danger">
            <span class="text-muted fs-7 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Pending Vendor Balance</span>
            <h3 class="fw-bold text-danger mt-2 mb-1">৳ @Model.PendingPayouts.ToString("N0")</h3>
            <span class="text-muted fs-7">Awaiting payout release</span>
        </div>
    </div>
</div>

<!-- Ledger Accounts & Journal Entries Row -->
<div class="row g-4 mb-5">
    <!-- Chart of Accounts -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h6 class="fw-bold text-dark m-0">General Ledger Accounts</h6>
                <span class="text-muted fs-7">Real-time trial balance accounts</span>
            </div>
            <div class="card-body p-3">
                <div class="d-flex flex-column gap-2">
                    @foreach (var account in Model.LedgerAccountsList)
                    {
                        <div class="p-3 rounded-4 bg-light border d-flex align-items-center justify-content-between">
                            <div>
                                <span class="badge bg-secondary-subtle text-dark border fs-7 me-1">@account.Code</span>
                                <span class="fw-bold text-dark fs-7">@account.Name</span>
                                <div class="text-muted fs-7">Type: @account.Type</div>
                            </div>
                            <span class="fw-extrabold text-dark fs-6">৳ @account.Balance.ToString("N0")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Double-Entry Journal Log -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark m-0">Double-Entry Journal Entries</h6>
                    <span class="text-muted fs-7">Automated debit and credit transactions</span>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Balanced</span>
            </div>
            <div class="card-body p-0 pt-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Ref #</th>
                                <th class="py-3">Description</th>
                                <th class="py-3">Account</th>
                                <th class="py-3 text-end">Debit (Dr)</th>
                                <th class="pe-4 py-3 text-end">Credit (Cr)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.JournalEntriesList)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark fs-7">@entry.ReferenceNumber</td>
                                    <td class="text-dark fs-7" style="max-width: 200px;">@entry.Description</td>
                                    <td class="fs-7 fw-medium text-primary">@entry.AccountName</td>
                                    <td class="text-end fw-bold text-dark fs-7">
                                        @(entry.Debit > 0 ? $"৳ {entry.Debit:N0}" : "-")
                                    </td>
                                    <td class="pe-4 text-end fw-bold text-dark fs-7">
                                        @(entry.Credit > 0 ? $"৳ {entry.Credit:N0}" : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Initiate Vendor Payout -->
<div class="modal fade" id="payoutModal" tabindex="-1" aria-labelledby="payoutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="payoutModalLabel">Process Vendor Payout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" action="/Admin/Accounting?handler=ProcessPayout">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Select Vendor <span class="text-danger">*</span></label>
                        <select name="vendorName" class="form-select rounded-3" required>
                            <option value="">Select store...</option>
                            <option value="Nusrat Boutique">Nusrat Boutique (Pending: ৳145,000)</option>
                            <option value="Silk Emporium Rajshahi">Silk Emporium Rajshahi (Pending: ৳180,200)</option>
                            <option value="Heritage Jamdani House">Heritage Jamdani House (Pending: ৳85,000)</option>
                            <option value="Crafts of Bengal">Crafts of Bengal (Pending: ৳40,000)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Payout Amount (BDT) <span class="text-danger">*</span></label>
                        <input type="number" name="payoutAmount" value="50000" step="1000" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Payout Method</label>
                        <select class="form-select rounded-3">
                            <option>bKash Merchant Account</option>
                            <option>Nagad Corporate</option>
                            <option>City Bank BEFTN Transfer</option>
                            <option>Brac Bank EFT</option>
                        </select>
                    </div>
                    <div class="pt-2">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                            <i class="bi bi-wallet2 me-1"></i> Disburse Payout
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
