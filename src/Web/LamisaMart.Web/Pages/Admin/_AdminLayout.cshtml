<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LamisaMart Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #F8F9FA; font-family: 'Inter', sans-serif; }
        .admin-sidebar { width: 260px; min-height: 100vh; background-color: #1A365D; color: white; position: fixed; top: 0; left: 0; z-index: 1040; transition: transform 0.3s ease; }
        .admin-sidebar .nav-link { color: rgba(255,255,255,0.8); padding: 12px 20px; transition: 0.2s; }
        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active { background-color: rgba(255,255,255,0.1); color: white; border-left: 4px solid #C5A059; }
        .admin-sidebar .nav-link i { margin-right: 10px; width: 20px; text-align: center; }
        .admin-main { margin-left: 260px; padding: 20px; transition: margin-left 0.3s ease; }
        
        @@media (max-width: 991.98px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-sidebar.show { transform: translateX(0); }
            .admin-main { margin-left: 0; padding: 15px; }
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="admin-sidebar shadow" id="adminSidebar">
            <div class="p-4 mb-3 text-center border-bottom border-light border-opacity-25 d-flex justify-content-between align-items-center">
                <div class="text-center w-100">
                    <div class="fw-bold fs-4 text-white">LAMISA <span style="color: #C5A059;">MART</span></div>
                    <div class="small text-white-50">Platform Admin Panel</div>
                </div>
                <button class="btn text-white-50 d-lg-none p-0" onclick="toggleSidebar()"><i class="bi bi-x-lg fs-5"></i></button>
            </div>
            
            <ul class="nav flex-column mb-auto">
                <li class="nav-item">
                    <a href="/Admin" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <i class="bi bi-cart3"></i> Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <i class="bi bi-shop"></i> Vendors
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Admin/PageBuilder" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/PageBuilder" ? "active" : "")">
                        <i class="bi bi-layout-wtf"></i> Page Builder
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <i class="bi bi-cash-coin"></i> Accounting
                    </a>
                </li>
                <li class="nav-item mt-4">
                    <a href="/" class="nav-link text-warning">
                        <i class="bi bi-box-arrow-up-right"></i> View Storefront
                    </a>
                </li>
            </ul>
        </div>
        
        <!-- Main Content -->
        <div class="admin-main flex-grow-1">
            <!-- Topbar -->
            <div class="bg-white p-3 rounded-4 shadow-sm mb-4 d-flex justify-content-between align-items-center">
                <button class="btn btn-outline-secondary d-lg-none" onclick="toggleSidebar()"><i class="bi bi-list"></i> Menu</button>
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <div class="position-relative">
                        <i class="bi bi-bell fs-5 text-muted"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">3</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 border-start ps-3 ms-2">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width:36px; height:36px;">AD</div>
                        <div class="fw-medium small d-none d-sm-block">Super Admin</div>
                    </div>
                </div>
            </div>
            
            @RenderBody()
        </div>
    </div>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('show');
        }
    </script>
</body>
</html>
