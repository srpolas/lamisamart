<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LamisaMart SuperAdmin</title>
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Chart.js for Advanced Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <style>
        body { background-color: #F8F9FA; font-family: 'Inter', system-ui, -apple-system, sans-serif; }
        .admin-sidebar { width: 260px; min-height: 100vh; background-color: #0F172A; color: white; position: fixed; top: 0; left: 0; z-index: 1040; transition: transform 0.3s ease; }
        .admin-sidebar .nav-link { color: rgba(255,255,255,0.75); padding: 10px 20px; transition: all 0.2s; font-weight: 500; font-size: 0.9rem; }
        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active { background-color: rgba(255,255,255,0.1); color: #ffffff; border-left: 4px solid #E11D48; }
        .admin-sidebar .nav-link i { margin-right: 12px; width: 20px; text-align: center; font-size: 1.1rem; }
        
        .admin-sidebar .submenu-link { color: rgba(255,255,255,0.65); padding: 8px 15px 8px 48px; font-size: 0.85rem; display: block; text-decoration: none; transition: all 0.2s; }
        .admin-sidebar .submenu-link:hover, .admin-sidebar .submenu-link.active { color: #ffffff; background-color: rgba(225, 29, 72, 0.15); border-left: 3px solid #E11D48; }

        .admin-main { margin-left: 260px; padding: 24px; transition: margin-left 0.3s ease; min-height: 100vh; }
        
        .card-stat { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .card-stat:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }

        @@media (max-width: 991.98px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-sidebar.show { transform: translateX(0); }
            .admin-main { margin-left: 0; padding: 15px; }
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="admin-sidebar shadow-lg" id="adminSidebar">
            <div class="p-4 mb-2 text-center border-bottom border-light border-opacity-10 d-flex justify-content-between align-items-center">
                <div class="text-center w-100">
                    <div class="fw-bold fs-4 text-white">LAMISA <span class="text-danger">MART</span></div>
                    <div class="small text-white-50" style="font-size: 0.75rem;">SuperAdmin Control Panel</div>
                </div>
                <button class="btn text-white-50 d-lg-none p-0" onclick="toggleSidebar()"><i class="bi bi-x-lg fs-5"></i></button>
            </div>
            
            <ul class="nav flex-column mb-auto py-2">
                <li class="nav-item">
                    <a href="/Admin" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <!-- User & Access Main Menu with Submenus -->
                @{
                    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                    var isUsersActive = currentPage.StartsWith("/Admin/Users");
                }
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between cursor-pointer @(isUsersActive ? "active" : "")" 
                       data-bs-toggle="collapse" href="#usersSubmenu" role="button" aria-expanded="@(isUsersActive ? "true" : "false")">
                        <span><i class="bi bi-person-badge"></i> User & Access</span>
                        <i class="bi bi-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse @(isUsersActive ? "show" : "")" id="usersSubmenu">
                        <a href="/Admin/Users" class="submenu-link @(currentPage == "/Admin/Users" ? "active" : "")">
                            <i class="bi bi-people me-1"></i> All Users & Staff
                        </a>
                        <a href="/Admin/Users/Roles" class="submenu-link @(currentPage == "/Admin/Users/Roles" ? "active" : "")">
                            <i class="bi bi-shield-check me-1"></i> Role & Access Controls
                        </a>
                        <a href="/Admin/Users/VendorTeam" class="submenu-link @(currentPage == "/Admin/Users/VendorTeam" ? "active" : "")">
                            <i class="bi bi-person-gear me-1"></i> Vendor Team Members
                        </a>
                        <a href="/Admin/Users/AccessLogs" class="submenu-link @(currentPage == "/Admin/Users/AccessLogs" ? "active" : "")">
                            <i class="bi bi-clock-history me-1"></i> Access Logs & Audit
                        </a>
                    </div>
                </li>

                <!-- Business Main Menu with Submenus -->
                @{
                    var isBusinessActive = currentPage.StartsWith("/Admin/Business") || currentPage == "/Admin/Orders";
                }
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between cursor-pointer @(isBusinessActive ? "active" : "")" 
                       data-bs-toggle="collapse" href="#businessSubmenu" role="button" aria-expanded="@(isBusinessActive ? "true" : "false")">
                        <span><i class="bi bi-briefcase"></i> Business</span>
                        <i class="bi bi-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse @(isBusinessActive ? "show" : "")" id="businessSubmenu">
                        <a href="/Admin/Business/Status" class="submenu-link @(currentPage == "/Admin/Business/Status" ? "active" : "")">
                            <i class="bi bi-graph-up-arrow me-1"></i> Status (Dashboard)
                        </a>
                        <a href="/Admin/Business/Orders" class="submenu-link @(currentPage == "/Admin/Business/Orders" || currentPage == "/Admin/Orders" ? "active" : "")">
                            <i class="bi bi-cart3 me-1"></i> Orders
                        </a>
                        <a href="/Admin/Business/Customers" class="submenu-link @(currentPage == "/Admin/Business/Customers" ? "active" : "")">
                            <i class="bi bi-people me-1"></i> Customers
                        </a>
                        <a href="/Admin/Business/Reports" class="submenu-link @(currentPage == "/Admin/Business/Reports" ? "active" : "")">
                            <i class="bi bi-bar-chart-line me-1"></i> Reports
                        </a>
                        <a href="/Admin/Business/Settings" class="submenu-link @(currentPage == "/Admin/Business/Settings" ? "active" : "")">
                            <i class="bi bi-gear me-1"></i> Settings
                        </a>
                    </div>
                </li>

                <!-- UI Customization Main Menu with Submenus -->
                @{
                    var isUiActive = currentPage.StartsWith("/Admin/UICustomization");
                }
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between cursor-pointer @(isUiActive ? "active" : "")" 
                       data-bs-toggle="collapse" href="#uiCustomSubmenu" role="button" aria-expanded="@(isUiActive ? "true" : "false")">
                        <span><i class="bi bi-palette"></i> UI Customization</span>
                        <i class="bi bi-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse @(isUiActive ? "show" : "")" id="uiCustomSubmenu">
                        <a href="/Admin/UICustomization/Header" class="submenu-link @(currentPage == "/Admin/UICustomization/Header" ? "active" : "")">
                            <i class="bi bi-layout-sidebar me-1"></i> Header
                        </a>
                        <a href="/Admin/UICustomization/Footer" class="submenu-link @(currentPage == "/Admin/UICustomization/Footer" ? "active" : "")">
                            <i class="bi bi-layout-south me-1"></i> Footer
                        </a>
                        <a href="/Admin/UICustomization/Widgets" class="submenu-link @(currentPage == "/Admin/UICustomization/Widgets" ? "active" : "")">
                            <i class="bi bi-window-stack me-1"></i> Widgets
                        </a>
                        <a href="/Admin/UICustomization/Settings" class="submenu-link @(currentPage == "/Admin/UICustomization/Settings" ? "active" : "")">
                            <i class="bi bi-sliders me-1"></i> Setting
                        </a>
                    </div>
                </li>

                <!-- Pages Main Menu -->
                @{
                    var isPagesActive = currentPage.StartsWith("/Admin/Pages");
                }
                <li class="nav-item">
                    <a href="/Admin/Pages" class="nav-link @(isPagesActive ? "active" : "")">
                        <i class="bi bi-file-earmark-richtext"></i> Pages CMS
                    </a>
                </li>

                <!-- Product Main Menu with Submenus -->
                @{
                    var isProductActive = currentPage.StartsWith("/Admin/Products");
                }
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between cursor-pointer @(isProductActive ? "active" : "")" 
                       data-bs-toggle="collapse" href="#productSubmenu" role="button" aria-expanded="@(isProductActive ? "true" : "false")">
                        <span><i class="bi bi-box-seam"></i> Product</span>
                        <i class="bi bi-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse @(isProductActive ? "show" : "")" id="productSubmenu">
                        <a href="/Admin/Products" class="submenu-link @(currentPage == "/Admin/Products" ? "active" : "")">
                            <i class="bi bi-card-list me-1"></i> All Products
                        </a>
                        <a href="/Admin/Products/Brands" class="submenu-link @(currentPage == "/Admin/Products/Brands" ? "active" : "")">
                            <i class="bi bi-award me-1"></i> Brands
                        </a>
                        <a href="/Admin/Products/Categories" class="submenu-link @(currentPage == "/Admin/Products/Categories" ? "active" : "")">
                            <i class="bi bi-grid-3x3-gap me-1"></i> Category
                        </a>
                        <a href="/Admin/Products/Tags" class="submenu-link @(currentPage == "/Admin/Products/Tags" ? "active" : "")">
                            <i class="bi bi-tags me-1"></i> Tags
                        </a>
                        <a href="/Admin/Products/Attributes" class="submenu-link @(currentPage == "/Admin/Products/Attributes" ? "active" : "")">
                            <i class="bi bi-sliders me-1"></i> Attributes
                        </a>
                        <a href="/Admin/Products/Reviews" class="submenu-link @(currentPage == "/Admin/Products/Reviews" ? "active" : "")">
                            <i class="bi bi-star-half me-1"></i> Reviews
                        </a>
                    </div>
                </li>

                <li class="nav-item">
                    <a href="/Admin/Vendors" class="nav-link @(currentPage == "/Admin/Vendors" ? "active" : "")">
                        <i class="bi bi-shop"></i> Vendors <span class="badge bg-warning text-dark ms-auto fs-7 rounded-pill">5 New</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Admin/Accounting" class="nav-link @(currentPage == "/Admin/Accounting" ? "active" : "")">
                        <i class="bi bi-calculator"></i> Accounting Ledger
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Admin/PageBuilder" class="nav-link @(currentPage == "/Admin/PageBuilder" ? "active" : "")">
                        <i class="bi bi-layout-wtf"></i> Dynamic Layout Builder
                    </a>
                </li>
                <li class="nav-item mt-4 pt-3 border-top border-light border-opacity-10">
                    <a href="/" class="nav-link text-warning">
                        <i class="bi bi-box-arrow-up-right"></i> View Storefront
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/account/logout" class="nav-link text-danger">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </a>
                </li>
            </ul>
        </div>
        
        <!-- Main Content Area -->
        <div class="admin-main flex-grow-1">
            <!-- Topbar Navigation Header -->
            <div class="bg-white p-3 rounded-4 shadow-sm mb-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary d-lg-none" onclick="toggleSidebar()"><i class="bi bi-list fs-5"></i></button>
                    <div class="d-none d-md-block">
                        <span class="text-muted small">System Status:</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">
                            <i class="bi bi-circle-fill fs-7 me-1"></i> Live & Operational
                        </span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative cursor-pointer">
                        <i class="bi bi-bell fs-5 text-muted"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">5</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 border-start ps-3 ms-2">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-7 shadow-sm" style="width:38px; height:38px;">
                            SA
                        </div>
                        <div class="d-none d-sm-block">
                            <div class="fw-bold small lh-1 text-dark">@(User.Identity?.Name ?? "SuperAdmin")</div>
                            <span class="badge bg-danger-subtle text-danger fs-7 mt-1">SuperAdmin</span>
                        </div>
                        <a href="/account/logout" class="btn btn-sm btn-outline-danger ms-2 px-3 rounded-pill" title="Sign Out">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
            
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
