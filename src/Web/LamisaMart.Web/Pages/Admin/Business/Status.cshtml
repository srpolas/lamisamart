@page "/Admin/Business/Status"
@model LamisaMart.Web.Pages.Admin.Business.StatusModel
@{
    ViewData["Title"] = "Business Status & Analytics - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Business Status & Commercial Overview</h3>
        <p class="text-muted small mb-0">Track store performance, real-time sales volume, conversion rates, and revenue streams.</p>
    </div>
    <div>
        <a href="/Admin/Business/Orders" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm">
            <i class="bi bi-cart3 me-1"></i> View Orders
        </a>
    </div>
</div>

<!-- Stat Cards Grid -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 card-stat bg-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold">TOTAL REVENUE</span>
                    <div class="rounded-circle bg-danger-subtle text-danger p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-currency-dollar fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">৳ @Model.TotalRevenue.ToString("N0")</h3>
                <span class="badge bg-success-subtle text-success fs-7 fw-bold">
                    <i class="bi bi-arrow-up-right me-1"></i>+18.4% vs last month
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 card-stat bg-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold">TOTAL ORDERS</span>
                    <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-bag-check fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">@Model.TotalOrders.ToString("N0")</h3>
                <span class="badge bg-primary-subtle text-primary fs-7 fw-bold">
                    <i class="bi bi-arrow-up-right me-1"></i>+12.6% growth
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 card-stat bg-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold">AVG ORDER VALUE</span>
                    <div class="rounded-circle bg-warning-subtle text-warning p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-receipt fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">৳ @Model.AverageOrderValue.ToString("N0")</h3>
                <span class="badge bg-warning-subtle text-warning text-dark fs-7 fw-bold">
                    Healthy AOV Metric
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 card-stat bg-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold">ACTIVE CUSTOMERS</span>
                    <div class="rounded-circle bg-info-subtle text-info p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-people fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">@Model.ActiveCustomers.ToString("N0")</h3>
                <span class="badge bg-info-subtle text-info fs-7 fw-bold">
                    @Model.ConversionRate% Conversion
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Commercial Performance Charts & Breakdown -->
<div class="row g-4 mb-5">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark m-0">Monthly Revenue & Sales Trend</h5>
                <span class="badge bg-light text-dark border">2026 Commercial Year</span>
            </div>
            <div style="height: 300px;">
                <canvas id="businessRevenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">Order Origins Breakdown</h5>
            <div style="height: 240px;" class="d-flex justify-content-center align-items-center">
                <canvas id="originDoughnutChart"></canvas>
            </div>
            <div class="mt-3 pt-2 border-top fs-7 text-muted">
                <div class="d-flex justify-content-between py-1">
                    <span><i class="bi bi-circle-fill text-danger me-1"></i> Storefront Web</span>
                    <span class="fw-bold text-dark">58%</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span><i class="bi bi-circle-fill text-primary me-1"></i> Mobile App</span>
                    <span class="fw-bold text-dark">24%</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span><i class="bi bi-circle-fill text-success me-1"></i> WhatsApp / Facebook</span>
                    <span class="fw-bold text-dark">18%</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx1 = document.getElementById('businessRevenueChart').getContext('2d');
        new Chart(ctx1, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'],
                datasets: [{
                    label: 'Revenue (BDT ৳)',
                    data: [280000, 320000, 390000, 410000, 450000, 470000, 460000, 485900],
                    borderColor: '#E11D48',
                    backgroundColor: 'rgba(225, 29, 72, 0.08)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        const ctx2 = document.getElementById('originDoughnutChart').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['Storefront Web', 'Mobile App', 'WhatsApp / Facebook'],
                datasets: [{
                    data: [58, 24, 18],
                    backgroundColor: ['#E11D48', '#2563EB', '#10B981']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });
    </script>
}
