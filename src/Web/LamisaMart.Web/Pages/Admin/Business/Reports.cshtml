@page "/Admin/Business/Reports"
@model LamisaMart.Web.Pages.Admin.Business.ReportsModel
@{
    ViewData["Title"] = "Business Reports - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Business Sales & Financial Reports</h3>
        <p class="text-muted small mb-0">Generate revenue breakdown reports, top category performance, and payment channel insights.</p>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart-fill me-2 text-danger"></i> Revenue by Product Category</h5>
            <ul class="list-group list-group-flush fs-7">
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                    <span>Sarees (Jamdani, Katan, Silk)</span>
                    <strong class="text-dark">৳ 245,800 (50.5%)</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                    <span>Three Piece & Lawn Sets</span>
                    <strong class="text-dark">৳ 112,400 (23.1%)</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                    <span>Kurtis & Salwar Sets</span>
                    <strong class="text-dark">৳ 68,200 (14.0%)</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                    <span>Jewelry & Handicrafts</span>
                    <strong class="text-dark">৳ 59,500 (12.4%)</strong>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-wallet2 me-2 text-primary"></i> Payment Gateway Method Share</h5>
            <ul class="list-group list-group-flush fs-7">
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                    <span><i class="bi bi-phone me-1 text-danger"></i> bKash Direct Wallet</span>
                    <strong class="text-dark">৳ 285,000 (58.6%)</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                    <span><i class="bi bi-truck me-1 text-warning"></i> Cash on Delivery (COD)</span>
                    <strong class="text-dark">৳ 142,000 (29.2%)</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                    <span><i class="bi bi-credit-card me-1 text-primary"></i> Nagad & Visa/Mastercard</span>
                    <strong class="text-dark">৳ 58,900 (12.2%)</strong>
                </li>
            </ul>
        </div>
    </div>
</div>
