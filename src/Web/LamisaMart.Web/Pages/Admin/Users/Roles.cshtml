@page "/Admin/Users/Roles"
@model LamisaMart.Web.Pages.Admin.Users.RolesModel
@{
    ViewData["Title"] = "Role & Controller Access Matrix - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Role & Controller Access Management</h3>
        <p class="text-muted small mb-0">Fine-grained permission matrix controlling access to system controllers, pages, and store operations.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark m-0"><i class="bi bi-shield-check me-2 text-danger"></i> Controller Level Permission Matrix</h5>
        <span class="badge bg-light text-dark border">5 Active User Roles</span>
    </div>
    <div class="card-body p-0">
        <form method="post" asp-page-handler="SavePermissions">
            @Html.AntiForgeryToken()
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 fs-7">
                    <thead class="bg-light text-muted border-bottom">
                        <tr>
                            <th class="ps-4 py-3">Controller / Module</th>
                            <th class="py-3">Allowed Operation / Functionality</th>
                            <th class="text-center py-3">SuperAdmin</th>
                            <th class="text-center py-3">Admin</th>
                            <th class="text-center py-3">Vendor Admin</th>
                            <th class="text-center py-3">Manager</th>
                            <th class="pe-4 text-center py-3">Sales Person</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var perm in Model.PermissionMatrix)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="bi bi-code-square me-1 text-primary"></i>@perm.ControllerName
                                </td>
                                <td class="text-muted">
                                    @perm.ActionDescription
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" checked disabled />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" @(perm.AdminAllowed ? "checked" : "") />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" @(perm.VendorAdminAllowed ? "checked" : "") />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" @(perm.ManagerAllowed ? "checked" : "") />
                                    </div>
                                </td>
                                <td class="pe-4 text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" @(perm.SalesPersonAllowed ? "checked" : "") />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 bg-light border-top text-end">
                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-floppy me-1"></i> Save Access Matrix
                </button>
            </div>
        </form>
    </div>
</div>
