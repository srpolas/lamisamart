@page "/Admin/Users"
@model LamisaMart.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User & Access Management - LamisaMart Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">User & Access Management</h3>
        <p class="text-muted small mb-0">Directory of all system users, admin staff, vendor team owners, managers, and sales representatives.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/Users/VendorTeam" class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Add Vendor Team Member
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small border-bottom">
                <tr>
                    <th class="ps-4 py-3">User Profile</th>
                    <th class="py-3">Contact Email & Phone</th>
                    <th class="py-3">Assigned System Role</th>
                    <th class="py-3">Associated Store / Vendor</th>
                    <th class="py-3 text-center">Status</th>
                    <th class="pe-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.UsersList)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-danger-subtle text-danger fw-bold d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    @user.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0 fs-7">@user.FullName</h6>
                                    <span class="text-muted fs-8">Joined: @user.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-medium text-dark fs-7"><i class="bi bi-envelope me-1 text-muted"></i>@user.Email</div>
                            <span class="text-muted fs-7"><i class="bi bi-telephone me-1 text-primary"></i>@user.Phone</span>
                        </td>
                        <td>
                            @if (user.Role == "SuperAdmin")
                            {
                                <span class="badge bg-danger shadow-sm rounded-pill px-3 py-1 fs-7">SuperAdmin</span>
                            }
                            else if (user.Role == "VendorAdmin")
                            {
                                <span class="badge bg-primary shadow-sm rounded-pill px-3 py-1 fs-7">Vendor Admin</span>
                            }
                            else if (user.Role == "Manager")
                            {
                                <span class="badge bg-warning text-dark shadow-sm rounded-pill px-3 py-1 fs-7">Store Manager</span>
                            }
                            else if (user.Role == "SalesPerson")
                            {
                                <span class="badge bg-success shadow-sm rounded-pill px-3 py-1 fs-7">Sales Person</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-1 fs-7">@user.Role</span>
                            }
                        </td>
                        <td>
                            <span class="fw-bold text-dark fs-7"><i class="bi bi-shop me-1 text-danger"></i>@user.AssociatedVendor</span>
                        </td>
                        <td class="text-center">
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fs-7">
                                    <i class="bi bi-check-circle-fill me-1"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1 fs-7">
                                    <i class="bi bi-lock-fill me-1 text-danger"></i> Suspended
                                </span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <!-- Edit User & Role Button -->
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px;"
                                        title="Edit User & Role"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editUserModal"
                                        onclick="populateEditUserModal('@user.Id', '@user.FullName', '@user.Email', '@user.Phone', '@user.Role', '@user.AssociatedVendor', @(user.IsActive ? "true" : "false"))">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <!-- Lock / Unlock Icon Button -->
                                <form method="post" asp-page-handler="ToggleUserStatus" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    @if (user.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                                style="width: 32px; height: 32px;"
                                                title="Lock (Disable User)">
                                            <i class="bi bi-lock-fill"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                                style="width: 32px; height: 32px;"
                                                title="Unlock (Enable User)">
                                            <i class="bi bi-unlock-fill"></i>
                                        </button>
                                    }
                                </form>

                                <!-- Delete User Button -->
                                <form method="post" asp-page-handler="DeleteUser" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this user account?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                            style="width: 32px; height: 32px;"
                                            title="Delete User Account">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Edit User & Role -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editUserModalLabel"><i class="bi bi-person-gear me-1 text-danger"></i> Edit User Profile & System Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="EditUser">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editUserId" name="userId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="editFullName" name="fullName" class="form-control rounded-3" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Email Address <span class="text-danger">*</span></label>
                            <input type="email" id="editEmail" name="email" class="form-control rounded-3" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Phone Number</label>
                            <input type="text" id="editPhone" name="phone" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Assigned System Role <span class="text-danger">*</span></label>
                        <select id="editRole" name="role" class="form-select rounded-3" required>
                            @foreach (var r in Model.RolesList)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <div class="form-text fs-8">Determines controller and page level permission matrix access.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Associated Store / Vendor</label>
                        <select id="editAssociatedVendor" name="associatedVendor" class="form-select rounded-3">
                            @foreach (var v in Model.VendorsList)
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="editIsActive" name="isActive" value="true" />
                            <label class="form-check-label fw-bold text-dark fs-7" for="editIsActive">Active Account Enabled</label>
                        </div>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="button" class="btn btn-light rounded-pill me-2 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-floppy me-1"></i> Save User & Role
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function populateEditUserModal(id, name, email, phone, role, vendor, active) {
            document.getElementById('editUserId').value = id;
            document.getElementById('editFullName').value = name;
            document.getElementById('editEmail').value = email;
            document.getElementById('editPhone').value = phone || '';
            document.getElementById('editRole').value = role;
            document.getElementById('editAssociatedVendor').value = vendor || 'Platform HQ';
            document.getElementById('editIsActive').checked = active;
        }
    </script>
}
