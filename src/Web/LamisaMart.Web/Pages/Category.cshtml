@page "/category/{slug?}"
@model CategoryModel
@{
    ViewData["Title"] = Model.CategoryName;
}

<!-- Category Hero Banner -->
<div class="position-relative bg-dark text-white mb-4 overflow-hidden" style="min-height: 240px; background: linear-gradient(135deg, #1f1216 0%, #4a1525 100%);">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.35; background-image: url('@Model.BannerUrl'); background-size: cover; background-position: center;"></div>
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to right, rgba(31,18,22,0.95) 0%, rgba(31,18,22,0.6) 60%, rgba(31,18,22,0.2) 100%);"></div>

    <div class="container position-relative py-5 z-1">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small text-white-50 mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i> Home</a></li>
                <li class="breadcrumb-item"><a href="/category/saree" class="text-white-50 text-decoration-none">Categories</a></li>
                <li class="breadcrumb-item active text-white fw-bold" aria-current="page">@Model.CategoryName</li>
            </ol>
        </nav>

        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge rounded-pill bg-danger px-3 py-2 text-uppercase fw-semibold" style="letter-spacing: 1px;">
                        <i class="bi bi-patch-check-fill me-1"></i> Verified Authentic
                    </span>
                    <span class="badge rounded-pill bg-warning text-dark px-3 py-2 fw-semibold">@Model.BengaliName</span>
                </div>
                <h1 class="display-6 fw-bold text-white mb-2">@Model.CategoryName</h1>
                <p class="lead text-white-50 fs-6 mb-3 max-w-75">@Model.Description</p>

                <div class="d-flex flex-wrap align-items-center gap-3 text-white-50 small">
                    <div class="d-flex align-items-center gap-1"><i class="bi bi-shield-check text-success fs-6"></i> 100% Handcrafted Guarantee</div>
                    <div>•</div>
                    <div class="d-flex align-items-center gap-1"><i class="bi bi-truck text-warning fs-6"></i> Express BD Delivery</div>
                    <div>•</div>
                    <div class="d-flex align-items-center gap-1"><i class="bi bi-arrow-counterclockwise text-info fs-6"></i> 7 Days Easy Return</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Subcategories Horizontal Navigation Pills -->
    @if (Model.SubCategories != null && Model.SubCategories.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold m-0 text-uppercase text-muted small" style="letter-spacing: 0.5px;">
                    <i class="bi bi-funnel me-1"></i> Explore Subcategories
                </h6>
            </div>
            <div class="d-flex gap-2 overflow-x-auto pb-2 scrollbar-hidden">
                @foreach (var subcat in Model.SubCategories)
                {
                    var isSelected = (string.IsNullOrEmpty(subcat.Slug) && string.IsNullOrEmpty(Model.Sub)) ||
                                     (!string.IsNullOrEmpty(subcat.Slug) && string.Equals(Model.Sub, subcat.Slug, StringComparison.OrdinalIgnoreCase));
                    <a href="/category/@Model.ActiveSlug@(string.IsNullOrEmpty(subcat.Slug) ? "" : $"?sub={subcat.Slug}")" 
                       class="btn btn-sm rounded-pill text-nowrap px-3 py-2 @(isSelected ? "btn-danger shadow-sm fw-bold" : "btn-outline-secondary bg-white")">
                        <i class="bi @subcat.Icon me-1"></i> @subcat.Name
                        <span class="badge rounded-pill @(isSelected ? "bg-white text-danger" : "bg-light text-dark") ms-1">@subcat.Count</span>
                    </a>
                }
            </div>
        </div>
    }

    <!-- Filtering & Sorting Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" action="/category/@Model.ActiveSlug" class="row g-2 align-items-center">
                @if (!string.IsNullOrEmpty(Model.Sub))
                {
                    <input type="hidden" name="sub" value="@Model.Sub" />
                }

                <!-- Left: Products Counter -->
                <div class="col-12 col-md-4 d-flex align-items-center justify-content-between justify-content-md-start">
                    <span class="fw-bold text-dark fs-6">
                        Showing <span class="text-danger">@Model.TotalProducts</span> Products
                    </span>
                    @if (!string.IsNullOrEmpty(Model.Sub) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue || !string.IsNullOrEmpty(Model.Sort))
                    {
                        <a href="/category/@Model.ActiveSlug" class="btn btn-sm btn-link text-muted text-decoration-none ms-2">
                            <i class="bi bi-x-circle me-1"></i> Clear Filters
                        </a>
                    }
                </div>

                <!-- Right: Search, Filter Dropdowns & Sorting -->
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                        <!-- In-Category Search -->
                        <div class="input-group input-group-sm" style="max-width: 220px;">
                            <input type="text" name="q" value="@Model.Q" class="form-control bg-light border-0" placeholder="Search in category..." />
                            <button class="btn btn-outline-secondary border-0 bg-light" type="submit"><i class="bi bi-search"></i></button>
                        </div>

                        <!-- Price Range Filter -->
                        <select name="minPrice" class="form-select form-select-sm border-0 bg-light fw-medium py-2 px-3" style="width: auto;" onchange="this.form.submit()">
                            <option value="">Price: Any</option>
                            <option value="0" selected="@(Model.MaxPrice == 2000)">Under ৳2,000</option>
                            <option value="2000" selected="@(Model.MinPrice == 2000 && Model.MaxPrice == 5000)">৳2,000 - ৳5,000</option>
                            <option value="5000" selected="@(Model.MinPrice == 5000 && Model.MaxPrice == 10000)">৳5,000 - ৳10,000</option>
                            <option value="10000" selected="@(Model.MinPrice == 10000)">Above ৳10,000</option>
                        </select>

                        <!-- Sort By -->
                        <select name="sort" class="form-select form-select-sm border-0 bg-light fw-medium py-2 px-3" style="width: auto;" onchange="this.form.submit()">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Sort: Popularity</option>
                            <option value="price-low" selected="@(Model.Sort == "price-low")">Price: Low to High</option>
                            <option value="price-high" selected="@(Model.Sort == "price-high")">Price: High to Low</option>
                            <option value="rating" selected="@(Model.Sort == "rating")">Highest Customer Rating</option>
                            <option value="newest" selected="@(Model.Sort == "newest")">Newest Arrivals</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Products Grid -->
    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4">
            @foreach (var item in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden lm-product-card position-relative transition-all hover-shadow-lg">
                        <!-- Top Badges -->
                        <div class="position-absolute top-0 start-0 p-2 z-2 d-flex flex-column gap-1">
                            @if (item.DiscountPercent > 0)
                            {
                                <span class="badge bg-danger shadow-sm fw-bold px-2 py-1 fs-7 rounded-pill">
                                    -@item.DiscountPercent% OFF
                                </span>
                            }
                            @if (item.IsBestSeller)
                            {
                                <span class="badge bg-warning text-dark shadow-sm fw-bold px-2 py-1 fs-7 rounded-pill">
                                    <i class="bi bi-fire me-1"></i> Best Seller
                                </span>
                            }
                        </div>

                        <!-- Wishlist Toggle Button -->
                        <button type="button" class="btn btn-light rounded-circle shadow-sm position-absolute top-0 end-0 m-2 z-2 p-0 d-flex align-items-center justify-content-center" 
                                style="width: 34px; height: 34px;" title="Add to Wishlist" onclick="toggleWishlist(this)">
                            <i class="bi bi-heart text-muted"></i>
                        </button>

                        <!-- Product Image Container -->
                        <a href="/Product/@item.Slug" class="d-block position-relative bg-light overflow-hidden text-center" style="aspect-ratio: 3/4;">
                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" class="w-100 h-100 object-fit-cover lm-product-img transition-transform duration-300" />
                        </a>

                        <!-- Product Content Body -->
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <!-- Vendor Name -->
                                <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                                    <span class="text-truncate" style="max-width: 140px;">
                                        <i class="bi bi-shop me-1 text-primary"></i> @item.VendorName
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.Material))
                                    {
                                        <span class="badge bg-light text-dark border small fw-normal">@item.Material</span>
                                    }
                                </div>

                                <!-- Product Title -->
                                <h6 class="card-title fw-bold text-dark lh-sm mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.4rem;">
                                    <a href="/Product/@item.Slug" class="text-dark text-decoration-none hover-danger">
                                        @item.Name
                                    </a>
                                </h6>
                            </div>

                            <div>
                                <!-- Ratings -->
                                <div class="d-flex align-items-center gap-1 small mb-2">
                                    <div class="text-warning fs-7">
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-half"></i>
                                    </div>
                                    <span class="fw-bold text-dark fs-7">@item.Rating.ToString("0.0")</span>
                                    <span class="text-muted fs-7">(@item.ReviewCount)</span>
                                </div>

                                <!-- Pricing Row -->
                                <div class="d-flex align-items-baseline gap-2 mb-3">
                                    <span class="fw-extrabold text-danger fs-5">৳ @item.Price.ToString("N0")</span>
                                    @if (item.OriginalPrice > item.Price)
                                    {
                                        <span class="text-muted text-decoration-line-through small">৳ @item.OriginalPrice.ToString("N0")</span>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-1"
                                            onclick="addToCart('@item.Id', '@item.Name', @item.Price)">
                                        <i class="bi bi-bag-plus fs-6"></i> Add to Cart
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination / Load More -->
        <div class="text-center mt-5">
            <button class="btn btn-outline-dark rounded-pill px-5 py-2 fw-bold shadow-sm" onclick="this.innerHTML='Loading...'; setTimeout(() => this.innerHTML='No More Products', 1000)">
                <i class="bi bi-arrow-down-circle me-1"></i> Load More Products
            </button>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5 my-5">
            <div class="mb-3">
                <i class="bi bi-bag-x text-muted display-1"></i>
            </div>
            <h4 class="fw-bold">No Products Found</h4>
            <p class="text-muted max-w-50 mx-auto">We couldn't find any products matching your selected category filters. Try clearing your filters or search query.</p>
            <a href="/category/@Model.ActiveSlug" class="btn btn-danger rounded-pill px-4 py-2 mt-2 fw-semibold">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Category Filters
            </a>
        </div>
    }

    <!-- Category Highlights & Trust Footer Block -->
    <div class="bg-light rounded-4 p-4 p-md-5 mt-5 border">
        <div class="row g-4 align-items-center">
            <div class="col-md-6">
                <h5 class="fw-bold mb-2">Why Shop @Model.CategoryName on LamisaMart?</h5>
                <p class="text-muted small mb-3">
                    LamisaMart brings together Bangladesh's most celebrated master weavers and boutique fashion vendors. When you purchase sarees, kurtis, or cosmetics from LamisaMart, you support local artisans while receiving guaranteed authentic products delivered right to your doorstep.
                </p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-patch-check-fill text-danger fs-4"></i>
                            <div>
                                <h6 class="fw-bold mb-0 small">Direct from Weavers</h6>
                                <span class="text-muted fs-7">No middleman markup</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-headset text-danger fs-4"></i>
                            <div>
                                <h6 class="fw-bold mb-0 small">Dedicated Support</h6>
                                <span class="text-muted fs-7">Call or Chat anytime</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-center text-md-end">
                <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600&q=80" alt="Authentic Bangladeshi Sarees" class="img-fluid rounded-4 shadow" style="max-height: 220px; object-fit: cover;" />
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification container for Add to Cart -->
<div class="toast-container position-fixed bottom-0 end-0 p-3 z-3">
    <div id="cartToast" class="toast align-items-center text-bg-success border-0 rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span id="toastMessage">Item added to your cart!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleWishlist(btn) {
            const icon = btn.querySelector('i');
            if (icon.classList.contains('bi-heart')) {
                icon.classList.remove('bi-heart', 'text-muted');
                icon.classList.add('bi-heart-fill', 'text-danger');
                btn.classList.add('bg-danger-subtle');
            } else {
                icon.classList.remove('bi-heart-fill', 'text-danger');
                icon.classList.add('bi-heart', 'text-muted');
                btn.classList.remove('bg-danger-subtle');
            }
        }

        function addToCart(id, name, price) {
            const toastEl = document.getElementById('cartToast');
            const toastMsg = document.getElementById('toastMessage');
            if (toastEl && toastMsg) {
                toastMsg.innerText = `"${name}" added to cart!`;
                const toast = new bootstrap.Toast(toastEl);
                toast.show();
            }
        }
    </script>
}
