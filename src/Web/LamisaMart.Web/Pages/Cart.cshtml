@page "/cart"
@model CartModel
@{
    ViewData["Title"] = "Shopping Cart - LamisaMart Bangladesh";
}

<div class="container my-3 my-md-5 py-2 py-md-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold fs-3 fs-md-2 m-0 text-dark">
            Shopping Cart <span class="text-muted fs-5 fw-normal" id="cartHeaderItemCount">(2 Items)</span>
        </h2>
        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold" id="btnClearCart" onclick="clearFullCart()">
            <i class="bi bi-trash me-1"></i> Clear Cart
        </button>
    </div>

    <!-- Empty Cart View State -->
    <div id="emptyCartView" class="text-center py-5 d-none bg-white rounded-4 shadow-sm p-4 border">
        <div class="mb-3">
            <i class="bi bi-cart-x text-muted display-1"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">Your Shopping Cart is Empty</h4>
        <p class="text-muted small mb-4">Looks like you haven't added any Jamdani, Katan Silk, or fashion items to your cart yet.</p>
        <a href="/" class="btn btn-danger btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm">
            <i class="bi bi-bag-plus me-2"></i> Start Shopping Now
        </a>
    </div>

    <!-- Active Cart Content Row -->
    <div class="row g-4" id="activeCartView">
        <!-- Cart Items Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3 p-md-4" id="cartItemsContainer">
                    <!-- Dynamic Cart Items Rendered via JavaScript -->
                </div>
            </div>
            
            <div class="d-flex justify-content-between align-items-center">
                <a href="/" class="text-decoration-none text-dark fw-bold d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-2 text-danger"></i> Continue Shopping
                </a>
            </div>
        </div>

        <!-- Order Summary & Coupon Column -->
        <div class="col-lg-4">
            <!-- Coupon Code Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-tag-fill me-2 text-danger"></i> Apply Coupon Code</h6>
                    <div class="input-group mb-2">
                        <input type="text" id="couponCodeInput" class="form-control text-uppercase rounded-start-3" placeholder="e.g. EID2026" />
                        <button type="button" class="btn btn-danger px-3 fw-bold rounded-end-3" onclick="applyCouponCode()">Apply</button>
                    </div>
                    <div class="form-text fs-8 text-muted">Try codes: <strong class="text-dark">EID2026</strong> (৳500 OFF) or <strong class="text-dark">FREESHIP</strong></div>
                    <div id="couponAlert" class="mt-2 d-none"></div>
                </div>
            </div>

            <!-- Order Summary Card -->
            <div class="card border-0 shadow-sm rounded-4" style="background-color: #FAF7F2;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Order Summary</h5>
                    
                    <div class="d-flex justify-content-between mb-3 fs-7">
                        <span class="text-muted">Subtotal (<span id="summaryTotalItems">2</span> items)</span>
                        <span class="fw-bold text-dark" id="summarySubtotal">৳ 0</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 fs-7">
                        <span class="text-muted">Estimated Delivery Fee</span>
                        <span class="fw-bold text-dark" id="summaryShipping">৳ 120</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 fs-7 d-none" id="discountRow">
                        <span class="text-muted">Coupon Discount</span>
                        <span class="text-success fw-bold" id="summaryDiscount">- ৳ 0</span>
                    </div>
                    
                    <hr class="text-muted opacity-25 mb-4" />
                    
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5 text-dark">Payable Total</span>
                        <span class="fw-extrabold fs-4 text-danger" id="summaryPayableTotal">৳ 0</span>
                    </div>
                    
                    <button type="button" class="btn btn-danger w-100 py-3 text-center fw-bold rounded-pill fs-6 shadow-sm mb-3" onclick="proceedToCheckout()">
                        PROCEED TO CHECKOUT <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                    
                    <div class="text-center border-top pt-3">
                        <div class="small text-muted mb-2 fs-8"><i class="bi bi-shield-lock-fill text-success me-1"></i> 100% Secure Checkout via SSLCommerz & bKash</div>
                        <div class="d-flex justify-content-center gap-2 text-muted fs-7">
                            <span>bKash</span> • <span>Nagad</span> • <span>Visa</span> • <span>Mastercard</span> • <span>COD</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const CART_STORAGE_KEY = 'lamisamart_cart';
        let cartItems = [];
        let appliedDiscountAmount = 0;
        let appliedCouponCode = '';

        const defaultSampleCart = [
            {
                id: 'prod-jamdani-100',
                name: 'Handwoven Dhakai Jamdani Saree (100 Count)',
                variant: 'Color: Ruby Red | Weave: 100 Count Pure',
                price: 3650,
                qty: 1,
                vendor: 'Narayanganj Weaver Guild',
                imageUrl: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=300&q=80'
            },
            {
                id: 'prod-katan-silk-200',
                name: 'Rajshahi Pure Katan Silk Saree',
                variant: 'Color: Royal Navy | Zari: Gold Zari',
                price: 12500,
                qty: 1,
                vendor: 'Silk Emporium Rajshahi',
                imageUrl: 'https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?w=300&q=80'
            }
        ];

        document.addEventListener('DOMContentLoaded', function () {
            loadCartItems();
        });

        function loadCartItems() {
            try {
                const storedJson = localStorage.getItem(CART_STORAGE_KEY);
                if (storedJson) {
                    cartItems = JSON.parse(storedJson);
                }
            } catch (e) {
                console.error("Error reading cart from localStorage:", e);
            }

            if (!cartItems || cartItems.length === 0) {
                cartItems = defaultSampleCart;
                saveCartToStorage();
            }

            renderCartUI();
        }

        function saveCartToStorage() {
            try {
                localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cartItems));
            } catch (e) {
                console.error("Error saving cart to localStorage:", e);
            }
        }

        function renderCartUI() {
            const container = document.getElementById('cartItemsContainer');
            const activeView = document.getElementById('activeCartView');
            const emptyView = document.getElementById('emptyCartView');
            const headerCount = document.getElementById('cartHeaderItemCount');
            const btnClear = document.getElementById('btnClearCart');

            if (!container) return;

            if (cartItems.length === 0) {
                activeView.classList.add('d-none');
                emptyView.classList.remove('d-none');
                if (headerCount) headerCount.innerText = '(0 Items)';
                if (btnClear) btnClear.classList.add('d-none');
                return;
            }

            activeView.classList.remove('d-none');
            emptyView.classList.add('d-none');
            if (btnClear) btnClear.classList.remove('d-none');

            const totalQtyCount = cartItems.reduce((acc, item) => acc + (item.qty || 1), 0);
            if (headerCount) headerCount.innerText = `(${totalQtyCount} Item${totalQtyCount > 1 ? 's' : ''})`;

            // Group by Vendor
            const vendorGroups = {};
            cartItems.forEach(item => {
                const vendor = item.vendor || 'LamisaMart Official';
                if (!vendorGroups[vendor]) vendorGroups[vendor] = [];
                vendorGroups[vendor].push(item);
            });

            let html = '';
            for (const [vendorName, items] of Object.entries(vendorGroups)) {
                html += `
                    <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                        <i class="bi bi-shop text-danger me-2 fs-5"></i>
                        <span class="fw-bold text-dark fs-6">${vendorName}</span>
                    </div>
                `;

                items.forEach((item, idx) => {
                    const itemTotal = (item.price || 0) * (item.qty || 1);
                    const globalIdx = cartItems.findIndex(i => i.id === item.id);

                    html += `
                        <div class="row g-3 align-items-center mb-4 pb-3 border-bottom">
                            <div class="col-3 col-sm-2">
                                <img src="${item.imageUrl || 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=150&q=80'}" class="img-fluid rounded-3 object-fit-cover shadow-sm" style="aspect-ratio: 1/1; width: 100%; max-width: 90px;" />
                            </div>
                            <div class="col-9 col-sm-4 ps-2">
                                <h6 class="fw-bold mb-1 fs-6 text-dark">${item.name}</h6>
                                <div class="text-muted small mb-1">${item.variant || ''}</div>
                                <div class="fw-bold text-danger">৳ ${(item.price || 0).toLocaleString('en-US')}</div>
                            </div>
                            <div class="col-7 col-sm-3 col-md-3 mt-2 mt-sm-0">
                                <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                                    <button class="btn btn-light px-2.5 fw-bold border-0" type="button" onclick="updateItemQuantity(${globalIdx}, -1)">-</button>
                                    <input type="text" class="form-control text-center px-1 fw-bold bg-white border-0" value="${item.qty || 1}" readonly>
                                    <button class="btn btn-light px-2.5 fw-bold border-0" type="button" onclick="updateItemQuantity(${globalIdx}, 1)">+</button>
                                </div>
                            </div>
                            <div class="col-5 col-sm-3 col-md-3 text-end mt-2 mt-sm-0">
                                <div class="fw-extrabold text-dark fs-6">৳ ${itemTotal.toLocaleString('en-US')}</div>
                                <button type="button" class="btn btn-link text-danger p-0 border-0 mt-1 small text-decoration-none" title="Remove Item" onclick="removeCartItem(${globalIdx})">
                                    <i class="bi bi-trash3 me-1"></i> Remove
                                </button>
                            </div>
                        </div>
                    `;
                });
            }

            container.innerHTML = html;
            calculateOrderSummary();
        }

        function updateItemQuantity(index, delta) {
            if (index < 0 || index >= cartItems.length) return;

            let current = cartItems[index].qty || 1;
            current += delta;

            if (current < 1) {
                removeCartItem(index);
                return;
            }
            if (current > 10) current = 10;

            cartItems[index].qty = current;
            saveCartToStorage();
            renderCartUI();
        }

        function removeCartItem(index) {
            if (index < 0 || index >= cartItems.length) return;
            cartItems.splice(index, 1);
            saveCartToStorage();
            renderCartUI();
        }

        function clearFullCart() {
            if (confirm("Are you sure you want to clear all items from your shopping cart?")) {
                cartItems = [];
                saveCartToStorage();
                renderCartUI();
            }
        }

        function calculateOrderSummary() {
            const subtotal = cartItems.reduce((acc, item) => acc + ((item.price || 0) * (item.qty || 1)), 0);
            const shipping = subtotal >= 5000 ? 0 : 120; // Free shipping threshold ৳5,000

            let payable = subtotal + shipping - appliedDiscountAmount;
            if (payable < 0) payable = 0;

            const totalItems = cartItems.reduce((acc, item) => acc + (item.qty || 1), 0);

            const summaryItemsEl = document.getElementById('summaryTotalItems');
            if (summaryItemsEl) summaryItemsEl.innerText = totalItems;

            const subtotalEl = document.getElementById('summarySubtotal');
            if (subtotalEl) subtotalEl.innerText = '৳ ' + subtotal.toLocaleString('en-US');

            const shippingEl = document.getElementById('summaryShipping');
            if (shippingEl) shippingEl.innerText = shipping === 0 ? 'FREE' : '৳ ' + shipping.toLocaleString('en-US');

            const discountRow = document.getElementById('discountRow');
            const discountEl = document.getElementById('summaryDiscount');
            if (appliedDiscountAmount > 0) {
                if (discountRow) discountRow.classList.remove('d-none');
                if (discountEl) discountEl.innerText = '- ৳ ' + appliedDiscountAmount.toLocaleString('en-US');
            } else {
                if (discountRow) discountRow.classList.add('d-none');
            }

            const payableEl = document.getElementById('summaryPayableTotal');
            if (payableEl) payableEl.innerText = '৳ ' + payable.toLocaleString('en-US');
        }

        function applyCouponCode() {
            const input = document.getElementById('couponCodeInput');
            const alertEl = document.getElementById('couponAlert');
            if (!input || !alertEl) return;

            const code = input.value.trim().toUpperCase();
            if (!code) {
                alertEl.className = 'alert alert-warning py-2 px-3 small rounded-3 mb-0';
                alertEl.innerText = 'Please enter a coupon code.';
                alertEl.classList.remove('d-none');
                return;
            }

            const subtotal = cartItems.reduce((acc, item) => acc + ((item.price || 0) * (item.qty || 1)), 0);

            if (code === 'EID2026') {
                appliedDiscountAmount = 500;
                appliedCouponCode = 'EID2026';
                alertEl.className = 'alert alert-success py-2 px-3 small rounded-3 mb-0';
                alertEl.innerText = 'Coupon "EID2026" applied! You saved ৳500.';
                alertEl.classList.remove('d-none');
            } else if (code === 'FREESHIP') {
                appliedDiscountAmount = 120;
                appliedCouponCode = 'FREESHIP';
                alertEl.className = 'alert alert-success py-2 px-3 small rounded-3 mb-0';
                alertEl.innerText = 'Coupon "FREESHIP" applied! Free shipping granted.';
                alertEl.classList.remove('d-none');
            } else if (code === 'LAMISA10') {
                appliedDiscountAmount = Math.round(subtotal * 0.10);
                appliedCouponCode = 'LAMISA10';
                alertEl.className = 'alert alert-success py-2 px-3 small rounded-3 mb-0';
                alertEl.innerText = `Coupon "LAMISA10" applied! You saved ৳${appliedDiscountAmount}.`;
                alertEl.classList.remove('d-none');
            } else {
                alertEl.className = 'alert alert-danger py-2 px-3 small rounded-3 mb-0';
                alertEl.innerText = 'Invalid or expired coupon code.';
                alertEl.classList.remove('d-none');
                return;
            }

            calculateOrderSummary();
        }

        function proceedToCheckout() {
            if (!cartItems || cartItems.length === 0) {
                alert("Your cart is empty. Please add items to proceed.");
                return;
            }

            saveCartToStorage();
            window.location.href = '/Checkout';
        }
    </script>
}
