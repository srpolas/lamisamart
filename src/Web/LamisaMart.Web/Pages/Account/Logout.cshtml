@page "/account/logout"
@model LamisaMart.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Log Out - LamisaMart";
}

<div class="container py-5 text-center my-5">
    <div class="mb-3">
        <i class="bi bi-box-arrow-right text-danger display-1"></i>
    </div>
    <h3 class="fw-bold text-dark mb-2">You Have Been Logged Out</h3>
    <p class="text-muted max-w-50 mx-auto">Thank you for using LamisaMart. You have successfully signed out of your account.</p>
    <div class="mt-4 gap-2 d-flex justify-content-center">
        <a href="/account/login" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">
            <i class="bi bi-box-arrow-in-right me-1"></i> Log In Again
        </a>
        <a href="/" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold">
            <i class="bi bi-house me-1"></i> Return to Storefront
        </a>
    </div>
</div>
