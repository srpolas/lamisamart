@page "/account/login"
@model LamisaMart.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Admin Login - LamisaMart";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #31102f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: #f8fafc;
        }
        .login-card {
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 440px;
        }
        .brand-badge {
            background: linear-gradient(135deg, #B83256 0%, #E11D48 100%);
            width: 54px;
            height: 54px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.5rem;
            color: white;
            box-shadow: 0 10px 20px -5px rgba(225, 29, 72, 0.5);
        }
        .form-control {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #f8fafc;
            border-radius: 12px;
            padding: 12px 16px;
        }
        .form-control:focus {
            background: rgba(15, 23, 42, 0.9);
            border-color: #E11D48;
            color: #ffffff;
            box-shadow: 0 0 0 4px rgba(225, 29, 72, 0.2);
        }
        .form-control::placeholder {
            color: #94a3b8;
        }
        .btn-submit {
            background: linear-gradient(135deg, #B83256 0%, #E11D48 100%);
            border: none;
            color: white;
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(225, 29, 72, 0.5);
            color: white;
        }
    </style>
</head>
<body>
    <div class="container p-3">
        <div class="login-card p-4 p-sm-5 mx-auto">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="brand-badge mx-auto mb-3">LM</div>
                <h4 class="fw-bold mb-1">LAMISA MART</h4>
                <p class="text-white-50 small mb-0"><i class="bi bi-shield-lock text-warning me-1"></i> SuperAdmin Access Locked</p>
            </div>

            <!-- Validation Error Messages -->
            <div asp-validation-summary="All" class="text-danger small mb-3 text-center fw-semibold"></div>

            <!-- Login Form -->
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-white-50">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-white-50 border-secondary-subtle rounded-start-3">
                            <i class="bi bi-person"></i>
                        </span>
                        <input type="text" asp-for="Input.EmailOrUsername" class="form-control border-start-0" placeholder="admin@lamisamart.bd" required autofocus />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-white-50">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-white-50 border-secondary-subtle rounded-start-3">
                            <i class="bi bi-key"></i>
                        </span>
                        <input type="password" id="passwordInput" asp-for="Input.Password" class="form-control border-start-0 border-end-0" placeholder="••••••••" required />
                        <button class="btn btn-outline-secondary text-white-50 border-start-0 border-secondary-subtle rounded-end-3" type="button" onclick="togglePasswordVisibility()">
                            <i class="bi bi-eye" id="toggleEye"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check">
                        <input type="checkbox" asp-for="Input.RememberMe" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label small text-white-50" for="rememberMe">Remember me</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-submit w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-in-right fs-5"></i> Log In to SuperAdmin Panel
                </button>
            </form>

            <!-- Default Credentials Banner for Convenience -->
            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                <div class="bg-dark bg-opacity-50 p-3 rounded-3 border border-secondary border-opacity-25 small text-white-50">
                    <div class="d-flex align-items-center gap-2 mb-1 text-warning fw-bold">
                        <i class="bi bi-key-fill"></i> Default SuperAdmin Credentials:
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Username / Email:</span>
                        <code class="text-info bg-transparent">admin@lamisamart.bd</code>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Password:</span>
                        <code class="text-warning bg-transparent">@@Admin123</code>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="text-white-50 small text-decoration-none hover-white">
                    <i class="bi bi-arrow-left me-1"></i> Return to Storefront
                </a>
            </div>
        </div>
    </div>

    <script>
        function togglePasswordVisibility() {
            const pass = document.getElementById('passwordInput');
            const eye = document.getElementById('toggleEye');
            if (pass.type === 'password') {
                pass.type = 'text';
                eye.classList.remove('bi-eye');
                eye.classList.add('bi-eye-slash');
            } else {
                pass.type = 'password';
                eye.classList.remove('bi-eye-slash');
                eye.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
