@page "{slug?}"
@model ShopModel
@{
    ViewData["Title"] = "Nusrat Boutique";
}

<!-- Shop Banner -->
<div class="position-relative bg-light mb-4 mb-md-5" style="min-height: 200px; height: 25vh; max-height: 300px; overflow: hidden;">
    <img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?w=1200&q=80" class="w-100 h-100 object-fit-cover opacity-75" alt="Shop Banner" />
    <div class="position-absolute bottom-0 start-0 w-100 bg-white" style="height: 60px; transform: translateY(1px); border-radius: 24px 24px 0 0;"></div>
    
    <div class="position-absolute top-100 start-50 translate-middle text-center w-100 px-3" style="margin-top: -50px;">
        <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=150&q=80" class="rounded-circle border border-4 border-white shadow bg-white" style="width: 100px; height: 100px; object-fit: cover;" />
        <h3 class="fw-bold mt-2 mb-0 fs-4 fs-md-3">Nusrat Boutique <i class="bi bi-patch-check-fill text-primary fs-5"></i></h3>
        <div class="text-warning small mb-1">
            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
            <span class="text-muted ms-1">(4.8 / 1.2k Ratings)</span>
        </div>
        <p class="text-muted small mb-0">Specialized in Premium Sarees and 3-Pieces from Narayanganj</p>
    </div>
</div>

<div class="container" style="margin-top: 110px; margin-bottom: 60px;">
    
    <!-- Filter Bar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 pb-3 border-bottom">
        <h5 class="fw-bold m-0 fs-6 fs-md-5">All Products (42)</h5>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm border-0 bg-light fw-medium py-2 px-3">
                <option>Category: All</option>
                <option>Saree</option>
                <option>Three Piece</option>
            </select>
            <select class="form-select form-select-sm border-0 bg-light fw-medium py-2 px-3">
                <option>Sort: Best Match</option>
                <option>Price: Low to High</option>
                <option>Price: High to Low</option>
                <option>Newest</option>
            </select>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="lm-products-grid">
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=500&q=80" alt="Premium Silk Saree" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Premium Jamdani Silk Saree</h6>
                <div class="lm-product-price">৳ 3,650</div>
            </div>
        </div>
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=500&q=80" alt="Embroidered 3 Piece" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Embroidered 3 Piece</h6>
                <div class="lm-product-price">৳ 2,450</div>
            </div>
        </div>
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=500&q=80" alt="Cotton Kurti Set" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Cotton Kurti Set</h6>
                <div class="lm-product-price">৳ 1,850</div>
            </div>
        </div>
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?w=500&q=80" alt="Designer Party Saree" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Designer Party Saree</h6>
                <div class="lm-product-price">৳ 4,250</div>
            </div>
        </div>
    </div>
    
    <div class="text-center mt-4 mt-md-5">
        <button class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold small">Load More</button>
    </div>
</div>
