@page "{slug?}"
@model ProductModel
@{
    ViewData["Title"] = "Product Details";
}

<div class="container my-3 my-md-5 py-2 py-md-4">
    <div class="row gx-lg-5">
        <!-- Product Images -->
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="position-relative bg-light rounded-4 overflow-hidden shadow-sm" style="max-height: 480px; aspect-ratio: 4/5;">
                <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=800&q=80" alt="Premium Silk Saree" class="img-fluid w-100 h-100 object-fit-cover" id="mainImage" />
                <button class="btn btn-light position-absolute top-0 end-0 m-3 rounded-circle shadow-sm" style="width:40px;height:40px;" aria-label="Wishlist"><i class="bi bi-heart text-danger"></i></button>
            </div>
            <!-- Thumbnails -->
            <div class="d-flex gap-2 gap-md-3 mt-3 overflow-auto pb-2">
                <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=150&q=80" class="rounded-3 border border-2 border-danger shadow-sm cursor-pointer" style="width: 70px; height: 70px; object-fit: cover;" />
                <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=150&q=80" class="rounded-3 border border-1 cursor-pointer opacity-75 hover-opacity-100" style="width: 70px; height: 70px; object-fit: cover;" />
                <img src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?w=150&q=80" class="rounded-3 border border-1 cursor-pointer opacity-75 hover-opacity-100" style="width: 70px; height: 70px; object-fit: cover;" />
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-lg-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb fs-sm small">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a href="/category/saree" class="text-decoration-none text-muted">Saree</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Premium Silk Saree</li>
                </ol>
            </nav>

            <h1 class="display-6 fw-bold mb-2 text-dark fs-3 fs-md-2" style="font-family: 'Hind Siliguri', sans-serif;">Premium Jamdani Silk Saree</h1>
            
            <div class="d-flex align-items-center mb-3 flex-wrap gap-1">
                <div class="text-warning me-1">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                </div>
                <span class="text-muted small">(128 Reviews)</span>
                <span class="mx-2 text-muted d-none d-sm-inline">|</span>
                <span class="text-success small fw-medium"><i class="bi bi-check-circle me-1"></i> In Stock</span>
            </div>

            <div class="mb-3 mb-md-4">
                <span class="fs-2 fw-bold text-danger me-2">৳ 3,650</span>
                <span class="text-muted text-decoration-line-through fs-5">৳ 4,500</span>
                <span class="badge bg-danger ms-2 px-2 py-1 align-middle">Save 19%</span>
            </div>

            <p class="text-secondary mb-4 small fs-md-6" style="line-height: 1.6;">
                Exclusive premium Jamdani silk saree perfect for weddings and festive occasions. Comes with an unstitched blouse piece. Woven with pure golden zari thread directly by artisans in Narayanganj.
            </p>

            <hr class="text-muted opacity-25 my-4" />

            <!-- Variants (Color/Size) -->
            <div class="mb-4">
                <label class="fw-semibold mb-2 small">Select Color:</label>
                <div class="d-flex gap-2">
                    <div class="rounded-circle border border-2 border-danger p-1 cursor-pointer">
                        <div class="rounded-circle" style="width:28px; height:28px; background-color: #B83256;"></div>
                    </div>
                    <div class="rounded-circle border border-1 p-1 cursor-pointer">
                        <div class="rounded-circle" style="width:28px; height:28px; background-color: #1A365D;"></div>
                    </div>
                    <div class="rounded-circle border border-1 p-1 cursor-pointer">
                        <div class="rounded-circle" style="width:28px; height:28px; background-color: #047857;"></div>
                    </div>
                </div>
            </div>

            <!-- Add to Cart Action (Desktop / Main view) -->
            <div class="row g-2 mb-3 mt-4">
                <div class="col-4 col-sm-3">
                    <div class="input-group input-group-lg">
                        <button class="btn btn-outline-secondary px-2 bg-light fs-6" type="button">-</button>
                        <input type="text" class="form-control text-center fw-bold bg-light fs-6 px-1" value="1" readonly>
                        <button class="btn btn-outline-secondary px-2 bg-light fs-6" type="button">+</button>
                    </div>
                </div>
                <div class="col-8 col-sm-9">
                    <button class="lm-btn-primary w-100 h-100 fs-6 py-3">
                        <i class="bi bi-cart3 me-1"></i> ADD TO CART
                    </button>
                </div>
            </div>
            
            <div class="mb-4">
                 <button class="btn btn-dark w-100 fs-6 fw-bold py-3 text-uppercase rounded-3">
                    BUY IT NOW
                </button>
            </div>

            <div class="p-3 bg-light rounded-3 d-flex gap-3 align-items-center">
                <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=100&q=80" class="rounded-circle" style="width:48px; height:48px;" />
                <div>
                    <div class="small text-muted">Sold by</div>
                    <a href="/shop/nusrat-boutique" class="fw-bold text-dark text-decoration-none small fs-md-6">Nusrat Boutique <i class="bi bi-patch-check-fill text-primary"></i></a>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Floating Action Bar for Mobile Screens -->
<div class="lm-mobile-sticky-cta d-md-none">
    <div class="d-flex gap-2 w-100 align-items-center">
        <div>
            <div class="small text-muted" style="font-size: 10px;">Total Price</div>
            <div class="fw-bold text-danger">৳ 3,650</div>
        </div>
        <button class="lm-btn-primary flex-grow-1 py-2 fs-6">
            <i class="bi bi-cart3 me-1"></i> ADD TO CART
        </button>
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .hover-opacity-100:hover { opacity: 1 !important; transition: 0.2s ease; }
</style>
