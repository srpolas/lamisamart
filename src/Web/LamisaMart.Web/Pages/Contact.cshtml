@page "/contact"
@model ContactModel
@{
    ViewData["Title"] = "Contact Us - লমিসা মার্ট | LamisaMart";
}

<!-- Hero Section -->
<div class="position-relative bg-dark text-white overflow-hidden" style="min-height: 240px; background: linear-gradient(135deg, #1a080d 0%, #4a1525 100%);">
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" style="background-image: url('https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=1600&q=80'); background-size: cover; background-position: center;"></div>

    <div class="container position-relative py-5 z-1">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small text-white-50 mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i> Home</a></li>
                <li class="breadcrumb-item active text-white fw-bold" aria-current="page">Contact Us</li>
            </ol>
        </nav>

        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge rounded-pill bg-danger px-3 py-2 text-uppercase fw-semibold mb-2" style="letter-spacing: 1px;">
                    <i class="bi bi-headset me-1"></i> We're Here to Help
                </span>
                <h1 class="display-6 fw-bold text-white mb-2">Get in Touch with LamisaMart</h1>
                <p class="lead text-white-50 fs-6 max-w-75 mb-0">
                    Have questions about an order, payment, product sizing, or vendor registration? Our dedicated support team in Dhaka is ready to assist you.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    @if (Model.MessageSent)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-4 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-check-circle-fill text-success display-6"></i>
                <div>
                    <h5 class="fw-bold mb-1">Thank You! Your message has been sent successfully.</h5>
                    <p class="mb-0 small">Our customer support representative will get back to you within 24 hours.</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Contact Info Cards Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-all hover-shadow-lg text-center">
                <div class="rounded-circle bg-danger-subtle text-danger p-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-telephone-outbound fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Customer Support</h6>
                <p class="text-muted small mb-1">+880 1234-567890</p>
                <p class="text-muted small mb-0">+880 9612-345678</p>
                <span class="badge bg-light text-secondary border mt-2 small">Sat - Thu: 9AM - 9PM</span>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-all hover-shadow-lg text-center">
                <div class="rounded-circle bg-warning-subtle text-warning p-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-envelope-at fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Email Inquiries</h6>
                <p class="text-muted small mb-1">support@lamisamart.bd</p>
                <p class="text-muted small mb-0">info@lamisamart.bd</p>
                <span class="badge bg-light text-secondary border mt-2 small">24/7 Email Monitoring</span>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-all hover-shadow-lg text-center">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-geo-alt fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Headquarter Office</h6>
                <p class="text-muted small mb-0">House 42, Road 7A, Dhanmondi</p>
                <p class="text-muted small mb-0">Dhaka - 1209, Bangladesh</p>
                <span class="badge bg-light text-secondary border mt-2 small">Corporate Office</span>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-all hover-shadow-lg text-center">
                <div class="rounded-circle bg-success-subtle text-success p-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-shop fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">Vendor Onboarding</h6>
                <p class="text-muted small mb-1">vendor@lamisamart.bd</p>
                <a href="/Vendor" class="btn btn-sm btn-outline-success rounded-pill fw-bold mt-2">
                    Open Your Store <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Contact Form & Location Map Row -->
    <div class="row g-4 g-lg-5 align-items-stretch mb-5">
        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 h-100">
                <div class="mb-4">
                    <span class="text-danger fw-bold text-uppercase small" style="letter-spacing: 1px;">Send Us a Message</span>
                    <h3 class="fw-bold text-dark mt-1">How can we assist you today?</h3>
                    <p class="text-muted small mb-0">Fill out the form below and our team will get back to you promptly.</p>
                </div>

                <form method="post" action="/contact">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Full Name <span class="text-danger">*</span></label>
                            <input type="text" asp-for="FullName" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="e.g. Nusrat Jahan" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Phone Number <span class="text-danger">*</span></label>
                            <input type="tel" asp-for="PhoneNumber" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="01712-345678" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Email Address</label>
                            <input type="email" asp-for="Email" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="name@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Subject <span class="text-danger">*</span></label>
                            <select asp-for="Subject" class="form-select form-select-lg bg-light border-0 fs-6" required>
                                <option value="">Select a topic...</option>
                                <option value="Order Support">Order Tracking / Support</option>
                                <option value="Vendor Registration">Vendor / Seller Onboarding</option>
                                <option value="Payment Issue">bKash / Nagad Payment Issue</option>
                                <option value="Returns & Refund">Return or Exchange Request</option>
                                <option value="General Feedback">General Question or Feedback</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark">Your Message <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" rows="5" class="form-control bg-light border-0 fs-6" placeholder="Write down your question or order details here..." required></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 py-3 fw-bold w-100 shadow-sm">
                                Send Message <i class="bi bi-send me-1"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Location & Working Hours Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 h-100 bg-light">
                <h4 class="fw-bold text-dark mb-3">Visit Corporate HQ</h4>
                <p class="text-muted small mb-4">
                    Our corporate office is located in the heart of Dhanmondi. If you are a boutique owner looking to join LamisaMart as a vendor, feel free to visit us during business hours.
                </p>

                <!-- Map Frame Simulation -->
                <div class="rounded-4 overflow-hidden shadow-sm mb-4 bg-secondary-subtle d-flex align-items-center justify-content-center text-center p-4" style="height: 200px;">
                    <div>
                        <i class="bi bi-map text-danger display-4 mb-2"></i>
                        <h6 class="fw-bold mb-1">Dhanmondi Office, Dhaka</h6>
                        <p class="small text-muted mb-0">House 42, Road 7A, Dhanmondi, Dhaka 1209</p>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2">Customer Care Operating Hours</h6>
                <ul class="list-unstyled small text-muted lh-lg mb-4">
                    <li class="d-flex justify-content-between border-bottom py-1">
                        <span>Saturday - Thursday:</span>
                        <span class="fw-bold text-dark">9:00 AM - 9:00 PM</span>
                    </li>
                    <li class="d-flex justify-content-between border-bottom py-1">
                        <span>Friday:</span>
                        <span class="fw-bold text-danger">3:00 PM - 8:00 PM</span>
                    </li>
                    <li class="d-flex justify-content-between py-1">
                        <span>Online Order Placement:</span>
                        <span class="fw-bold text-success">24/7 Always Open</span>
                    </li>
                </ul>

                <div class="bg-white p-3 rounded-3 border">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill text-danger fs-4"></i>
                        <div>
                            <h6 class="fw-bold mb-0 small">Need Instant Order Assistance?</h6>
                            <span class="text-muted fs-7">Call Helpline: +880 1234-567890</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-5">
        <div class="text-center max-w-50 mx-auto mb-4">
            <span class="text-danger fw-bold text-uppercase small" style="letter-spacing: 1px;">Frequently Asked Questions</span>
            <h3 class="fw-bold text-dark mt-1">Got Questions? We Have Answers</h3>
        </div>

        <div class="accordion accordion-flush card border-0 shadow-sm rounded-4 overflow-hidden p-2" id="faqAccordion">
            <div class="accordion-item border-0 border-bottom">
                <h2 class="accordion-header" id="faqOne">
                    <button class="accordion-button fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        How do I place an order on LamisaMart?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="faqOne" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Browse our categories (Sarees, Three-Piece, Kurtis, Cosmetics), select your preferred size or variation, click "Add to Cart", and proceed to checkout. You can pay via bKash, Nagad, BanglaQR, Credit/Debit card, or Cash on Delivery.
                    </div>
                </div>
            </div>

            <div class="accordion-item border-0 border-bottom">
                <h2 class="accordion-header" id="faqTwo">
                    <button class="accordion-button collapsed fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        What are the delivery charges and delivery times?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="faqTwo" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Delivery inside Dhaka takes 24-48 hours (৳70 shipping fee), while delivery outside Dhaka takes 2-3 days (৳130 shipping fee). We offer Free Shipping on all orders above ৳1500!
                    </div>
                </div>
            </div>

            <div class="accordion-item border-0">
                <h2 class="accordion-header" id="faqThree">
                    <button class="accordion-button collapsed fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        How can I open my shop as a vendor on LamisaMart?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="faqThree" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Click on "Vendor Dashboard" or "Register as a Seller" from the main navigation menu. Fill in your shop name, contact number, and business details. Our vendor manager will verify your account within 24 hours so you can start listing products!
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
