@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@if (Model.PageLayout != null && Model.PageLayout.Sections.Any())
{
    @foreach (var section in Model.PageLayout.Sections)
    {
        <!-- Dynamically load partials based on CMS SectionType -->
        @await Html.PartialAsync($"Sections/_{section.SectionType}", section.ContentPayloadJson)
    }
}
else
{
<!-- Fallback / Default Design matched to LamisaMart.png if DB is empty -->
<!-- 1. Hero Section -->
<section class="container-fluid p-0 bg-light">
    <div class="container py-4 py-lg-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-6 ps-lg-5 text-center text-lg-start">
                <h1 class="display-5 fw-bold text-danger mb-2" style="color: #B83256 !important; font-family: 'Hind Siliguri', sans-serif;">
                    প্রতিদিনের সাজে,<br />লমিসা মার্ট।
                </h1>
                <p class="fs-5 text-secondary fw-medium mb-4">Everyday Elegance, Every Moment.</p>
                <a href="/category/saree" class="lm-btn-primary px-4 py-3 fs-6">
                    SHOP NOW <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="/images/LamisaMart_design_concept.png" alt="LamisaMart Hero" class="img-fluid rounded-4 shadow-sm" style="max-height: 380px; width: 100%; object-fit: cover; object-position: top;" />
            </div>
        </div>
    </div>
</section>

<!-- 2. Trust Badges Bar -->
<section class="lm-trust-bar">
    <div class="lm-trust-container">
        <div class="lm-trust-item">
            <i class="bi bi-shield-check lm-trust-icon"></i>
            <div>
                <h6 class="lm-trust-title">Secure Payment</h6>
                <p class="lm-trust-sub">100% secure payment</p>
            </div>
        </div>
        <div class="lm-trust-item">
            <i class="bi bi-truck lm-trust-icon"></i>
            <div>
                <h6 class="lm-trust-title">Fast Delivery</h6>
                <p class="lm-trust-sub">Across Bangladesh</p>
            </div>
        </div>
        <div class="lm-trust-item">
            <i class="bi bi-arrow-counterclockwise lm-trust-icon"></i>
            <div>
                <h6 class="lm-trust-title">Easy Returns</h6>
                <p class="lm-trust-sub">7 day return policy</p>
            </div>
        </div>
        <div class="lm-trust-item">
            <i class="bi bi-award lm-trust-icon"></i>
            <div>
                <h6 class="lm-trust-title">Best Quality</h6>
                <p class="lm-trust-sub">Premium Products</p>
            </div>
        </div>
    </div>
</section>

<!-- 3. Shop By Category (10 Categories + View All Button) -->
