@page
@model IndexModel
@{
    ViewData["Title"] = "Home - Premier Bangladeshi Fashion & Handloom Marketplace";
}

@if (Model.PageLayout != null && Model.PageLayout.Sections != null && Model.PageLayout.Sections.Count >= 4)
{
    @foreach (var section in Model.PageLayout.Sections)
    {
        try
        {
            @await Html.PartialAsync($"Shared/Sections/_{section.SectionType}", section.ContentPayloadJson)
        }
        catch
        {
            <!-- Fallback if individual section fail -->
        }
    }
}
else
{
    <!-- Complete Rich Storefront Home Page Design -->

    <!-- 1. Hero Section -->
    @await Html.PartialAsync("Shared/Sections/_HeroBanner", "")

    <!-- 2. Trust Badges Bar -->
    @await Html.PartialAsync("Shared/Sections/_TrustBadges", "")

    <!-- 3. Shop By Category -->
    @await Html.PartialAsync("Shared/Sections/_CategoryGrid", "")

    <!-- 4. New Arrivals Product Cards -->
    @await Html.PartialAsync("Shared/Sections/_NewArrivals", "")

    <!-- 5. Promotional Banners Row -->
    @await Html.PartialAsync("Shared/Sections/_PromotionalRow", "")

    <!-- 6. Featured Collections -->
    @await Html.PartialAsync("Shared/Sections/_FeaturedCollections", "")

    <!-- 7. Customer Reviews -->
    @await Html.PartialAsync("Shared/Sections/_CustomerReviews", "")
}
