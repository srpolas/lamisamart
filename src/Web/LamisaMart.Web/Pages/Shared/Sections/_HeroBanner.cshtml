@using LamisaMart.Web.Pages.Admin.UICustomization
@model string
@{
    var activeSlides = SliderModel.SlidesStore.Where(s => s.IsActive).OrderBy(s => s.SortOrder).ToList();
    if (!activeSlides.Any())
    {
        activeSlides = SliderModel.SlidesStore.OrderBy(s => s.SortOrder).ToList();
    }
}

<section class="container-fluid p-0 bg-light my-2 my-md-4">
    <div class="container py-2 py-lg-4">
        <div id="heroBannerCarousel" class="carousel slide carousel-fade rounded-4 shadow-sm overflow-hidden" data-bs-ride="carousel" data-bs-interval="4500">
            <!-- Carousel Indicators -->
            @if (activeSlides.Count > 1)
            {
                <div class="carousel-indicators mb-3">
                    @for (int i = 0; i < activeSlides.Count; i++)
                    {
                        <button type="button" data-bs-target="#heroBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
            }

            <!-- Carousel Slides -->
            <div class="carousel-inner">
                @for (int i = 0; i < activeSlides.Count; i++)
                {
                    var slide = activeSlides[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="row align-items-center g-4 p-4 p-lg-5" style="background-color: #FAF7F2; min-height: 380px;">
                            <div class="col-lg-6 ps-lg-4 text-center text-lg-start">
                                @if (!string.IsNullOrWhiteSpace(slide.BadgeText))
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill fs-7 mb-3 fw-bold">
                                        @slide.BadgeText
                                    </span>
                                }
                                <h1 class="display-6 fw-bold text-danger mb-3" style="color: #B83256 !important; font-family: 'Hind Siliguri', sans-serif;">
                                    @Html.Raw(slide.Title.Replace("\n", "<br/>"))
                                </h1>
                                @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
                                {
                                    <p class="fs-6 text-secondary fw-medium mb-4 lh-base">@slide.Subtitle</p>
                                }
                                <a href="@(string.IsNullOrWhiteSpace(slide.ButtonLink) ? "/category/saree" : slide.ButtonLink)" class="lm-btn-primary px-4 py-3 fs-6">
                                    @(string.IsNullOrWhiteSpace(slide.ButtonText) ? "SHOP NOW" : slide.ButtonText) <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </div>
                            <div class="col-lg-6 text-center">
                                <img src="@slide.ImageUrl" alt="@slide.Title" class="img-fluid rounded-4 shadow-sm" style="max-height: 360px; width: 100%; object-fit: cover; object-position: top;" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Carousel Controls -->
            @if (activeSlides.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#heroBannerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon rounded-circle bg-dark bg-opacity-50 p-3" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroBannerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon rounded-circle bg-dark bg-opacity-50 p-3" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
        </div>
    </div>
</section>
