@model string

<section class="container my-4 my-md-5">
    <div class="row g-3 g-md-4">
        <div class="col-12 col-md-4">
            <div class="p-4 rounded-4 text-white d-flex flex-column justify-content-between h-100" style="background-color: #B83256; min-height: 180px;">
                <div>
                    <span class="badge bg-white text-danger font-semibold mb-2">FLASH SALE</span>
                    <h3 class="fw-bold mb-1 fs-4 fs-md-3">Up to 50% OFF</h3>
                    <p class="small opacity-75">On selected handbags & accessories</p>
                </div>
                <a href="/category/sale" class="btn btn-light text-danger fw-bold rounded-pill align-self-start btn-sm px-3 mt-3">SHOP NOW ></a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="p-4 rounded-4 d-flex flex-column justify-content-between h-100" style="background-color: #FAF4EB; border: 1px solid #EFE4D6; min-height: 180px;">
                <div>
                    <span class="badge bg-gold text-white font-semibold mb-2" style="background-color: #C5A059;">NEW COLLECTION</span>
                    <h3 class="fw-bold mb-1 text-dark fs-4 fs-md-3">Summer Elegance</h3>
                    <p class="small text-muted">Lightweight cotton kurtis & lawn sets</p>
                </div>
                <a href="/category/kurti" class="btn btn-outline-dark fw-bold rounded-pill align-self-start btn-sm px-3 mt-3">EXPLORE NOW</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="p-4 rounded-4 text-white d-flex flex-column justify-content-between h-100" style="background-color: #A52A4A; min-height: 180px;">
                <div>
                    <span class="badge bg-white text-dark font-semibold mb-2">FREE DELIVERY</span>
                    <h3 class="fw-bold mb-1 fs-4 fs-md-3">On orders over ৳1500</h3>
                    <p class="small opacity-75">Fast delivery across all 64 districts</p>
                </div>
                <i class="bi bi-truck fs-1 align-self-end mt-2"></i>
            </div>
        </div>
    </div>
</section>
