@model string
@{
    string title = "Featured Artisan Products";
    if (!string.IsNullOrWhiteSpace(Model))
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(Model);
            if (doc.RootElement.TryGetProperty("title", out var t)) title = t.GetString() ?? title;
        }
        catch { }
    }
}

<section class="container my-4 my-md-5">
    <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4">
        <h4 class="fw-bold m-0 fs-5 fs-md-4" style="color: var(--lm-text-main);">@title</h4>
        <a href="/category/saree" class="text-danger fw-semibold small">View All <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="lm-products-grid">
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=500&q=80" alt="Premium Silk Saree" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Premium Dhakai Jamdani Saree</h6>
                <div class="lm-product-price">৳ 3,650</div>
            </div>
        </div>
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=500&q=80" alt="Embroidered 3 Piece" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Embroidered Three Piece Set</h6>
                <div class="lm-product-price">৳ 2,450</div>
            </div>
        </div>
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=500&q=80" alt="Cotton Kurti Set" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Cotton Designer Kurti Set</h6>
                <div class="lm-product-price">৳ 1,850</div>
            </div>
        </div>
        <div class="lm-product-card">
            <div class="lm-product-wishlist"><i class="bi bi-heart"></i></div>
            <img src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?w=500&q=80" alt="Designer Party Saree" class="lm-product-image" />
            <div class="lm-product-info">
                <h6 class="lm-product-title">Rajshahi Katan Silk Saree</h6>
                <div class="lm-product-price">৳ 12,500</div>
            </div>
        </div>
    </div>
</section>
