@model string
@{
    string title = "SHOP BY CATEGORY";
}

<section class="container my-4 my-md-5">
    <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4">
        <h4 class="fw-bold m-0 fs-5 fs-md-4 text-uppercase" style="color: var(--lm-text-main);">@title</h4>
        <a href="/category/saree" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-bold fs-7">
            View All <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="lm-categories-grid">
        <a href="/category/saree" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=300&q=80" alt="Saree" />
            </div>
            <span class="lm-category-label">SAREE</span>
        </a>
        <a href="/category/three-piece" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=300&q=80" alt="Three Piece" />
            </div>
            <span class="lm-category-label">THREE PIECE</span>
        </a>
        <a href="/category/kurti" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=300&q=80" alt="Kurti" />
            </div>
            <span class="lm-category-label">KURTI</span>
        </a>
        <a href="/category/lehenga-gown" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?w=300&q=80" alt="Lehenga & Gown" />
            </div>
            <span class="lm-category-label">LEHENGA</span>
        </a>
        <a href="/category/mens-panjabi" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1621786062579-6125bf25208a?w=300&q=80" alt="Men's Panjabi" />
            </div>
            <span class="lm-category-label">PANJABI</span>
        </a>
        <a href="/category/mens-apparel" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?w=300&q=80" alt="Men's Apparel" />
            </div>
            <span class="lm-category-label">MEN'S WEAR</span>
        </a>
        <a href="/category/kids-wear" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=300&q=80" alt="Kids Wear" />
            </div>
            <span class="lm-category-label">KIDS WEAR</span>
        </a>
        <a href="/category/footwear" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?w=300&q=80" alt="Footwear" />
            </div>
            <span class="lm-category-label">FOOTWEAR</span>
        </a>
        <a href="/category/bags" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=300&q=80" alt="Bags" />
            </div>
            <span class="lm-category-label">BAGS</span>
        </a>
        <a href="/category/jewelry" class="lm-category-card">
            <div class="lm-category-circle">
                <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=300&q=80" alt="Jewelry" />
            </div>
            <span class="lm-category-label">JEWELRY</span>
        </a>
    </div>
</section>
