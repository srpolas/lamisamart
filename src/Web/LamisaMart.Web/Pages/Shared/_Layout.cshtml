@using LamisaMart.Web.Pages.Admin.UICustomization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @HeaderModel.Settings.SiteName | Premier Bangladeshi Marketplace</title>
    <!-- Dynamic Favicon Icon -->
    <link rel="icon" type="image/x-icon" href="@(string.IsNullOrWhiteSpace(HeaderModel.Settings.FaviconUrl) ? "/favicon.ico" : HeaderModel.Settings.FaviconUrl)" />
    <!-- OpenGraph Site Title Image -->
    @if (!string.IsNullOrWhiteSpace(HeaderModel.Settings.SiteTitleImageUrl))
    {
        <meta property="og:image" content="@HeaderModel.Settings.SiteTitleImageUrl" />
    }

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .lm-top-bar { background-color: #0F172A; color: #94A3B8; font-size: 0.8rem; padding: 6px 0; }
        .lm-header { background: #ffffff; border-bottom: 1px solid #E2E8F0; padding: 12px 0; position: sticky; top: 0; z-index: 1030; }
        .lm-logo-container { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .lm-logo-badge { background: linear-gradient(135deg, #E11D48 0%, #9F1239 100%); color: white; font-weight: 800; font-size: 1.2rem; width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(225, 29, 72, 0.25); }
        .lm-logo-text { display: flex; flex-direction: column; }
        .lm-logo-title { font-weight: 800; font-size: 1.1rem; color: #0F172A; letter-spacing: -0.5px; line-height: 1; }
        .lm-logo-bengali { font-size: 0.75rem; color: #E11D48; font-weight: 600; }
        .lm-search-box { position: relative; width: 100%; max-width: 480px; }
        .lm-search-input { border-radius: 25px; padding-left: 20px; padding-right: 45px; height: 42px; border: 1.5px solid #CBD5E1; font-size: 0.9rem; }
        .lm-search-input:focus { border-color: #E11D48; box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.15); }
        .lm-search-btn { position: absolute; right: 4px; top: 4px; border-radius: 50%; width: 34px; height: 34px; border: none; background: #E11D48; color: white; display: flex; align-items: center; justify-content: center; }
        .lm-action-badge { position: absolute; top: -6px; right: -8px; background: #E11D48; color: white; font-size: 0.65rem; font-weight: 700; border-radius: 50%; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; border: 2px solid white; }
        .lm-main-nav { background: #FAF7F2; border-bottom: 1px solid #E2E8F0; overflow-x: auto; white-space: nowrap; }
        .lm-main-nav-inner { display: flex; gap: 4px; padding: 0 15px; }
        .lm-nav-link { padding: 10px 16px; color: #334155; font-weight: 600; font-size: 0.85rem; text-decoration: none; display: inline-block; transition: all 0.2s; }
        .lm-nav-link:hover, .lm-nav-link.active { color: #E11D48; background: rgba(225, 29, 72, 0.06); }
        .lm-btn-primary { background: linear-gradient(135deg, #E11D48 0%, #BE123C 100%); color: white; font-weight: 600; border-radius: 25px; padding: 10px 24px; border: none; transition: all 0.2s; box-shadow: 0 4px 14px rgba(225, 29, 72, 0.3); }
        .lm-btn-primary:hover { background: linear-gradient(135deg, #BE123C 0%, #9F1239 100%); color: white; transform: translateY(-1px); box-shadow: 0 6px 18px rgba(225, 29, 72, 0.4); }
        
        .lm-social-icon-btn { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .lm-social-icon-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.12) !important; }

        /* Mobile Sticky Navigation Bar */
        .lm-mobile-bottom-nav { display: none; position: fixed; bottom: 0; left: 0; right: 0; background: #ffffff; border-top: 1px solid #E2E8F0; z-index: 1040; padding: 6px 0; box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08); }
        .lm-action-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-decoration: none; color: #64748B; font-size: 0.7rem; font-weight: 500; position: relative; }
        .lm-action-item.active, .lm-action-item:hover { color: #E11D48; }
        .lm-action-icon { font-size: 1.25rem; margin-bottom: 2px; }

        @@media (max-width: 991.98px) {
            .lm-mobile-bottom-nav { display: flex; }
            body { padding-bottom: 60px; }
        }
    </style>
</head>
<body>
    <!-- Top Bar -->
    <div class="lm-top-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-telephone-fill text-danger me-1"></i> Helpline: @FooterModel.StoreSettings.SupportPhone</span>
                <span class="d-none d-md-inline"><i class="bi bi-truck me-1"></i> Cash on Delivery Nationwide</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/Admin" class="text-warning text-decoration-none fw-bold" style="font-size: 0.8rem;">
                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Portal
                </a>
                <a href="/vendor/register" class="text-light text-decoration-none d-none d-sm-inline">Become a Vendor</a>
                <a href="/contact" class="text-light text-decoration-none">Help & Contact</a>
            </div>
        </div>
    </div>

    <!-- Header -->
    <header class="lm-header">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <!-- Logo -->
                <a href="/" class="lm-logo-container">
                    @if (!string.IsNullOrWhiteSpace(HeaderModel.Settings.LogoUrl) && (HeaderModel.Settings.LogoUrl.StartsWith("/") || HeaderModel.Settings.LogoUrl.StartsWith("http")))
                    {
                        <img src="@HeaderModel.Settings.LogoUrl" alt="@HeaderModel.Settings.SiteName" style="max-height: 48px;" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                        <div class="d-none lm-logo-container">
                            <div class="lm-logo-badge">LM</div>
                            <div class="lm-logo-text">
                                <span class="lm-logo-title">@HeaderModel.Settings.SiteName</span>
                                <span class="lm-logo-bengali">@HeaderModel.Settings.SiteBengaliName</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="lm-logo-badge">LM</div>
                        <div class="lm-logo-text">
                            <span class="lm-logo-title">@HeaderModel.Settings.SiteName</span>
                            <span class="lm-logo-bengali">@HeaderModel.Settings.SiteBengaliName</span>
                        </div>
                    }
                </a>

                <!-- Search Bar -->
                <div class="lm-search-box d-none d-md-block">
                    <form action="/category/search" method="get">
                        <input type="text" name="q" class="form-control lm-search-input" placeholder="Search Jamdani Sarees, Three Pieces, Kurtis, Jewelry..." />
                        <button type="submit" class="lm-search-btn" title="Search"><i class="bi bi-search"></i></button>
                    </form>
                </div>

                <!-- Action Icons -->
                <div class="d-flex align-items-center gap-3">
                    <a href="/account/wishlist" class="text-dark position-relative text-decoration-none d-none d-sm-block p-1" title="Wishlist">
                        <i class="bi bi-heart fs-4"></i>
                        <span class="lm-action-badge">0</span>
                    </a>
                    <a href="/cart" class="text-dark position-relative text-decoration-none p-1" title="Cart">
                        <i class="bi bi-bag fs-4"></i>
                        <span class="lm-action-badge">2</span>
                    </a>
                    <a href="/account/login" class="btn btn-outline-dark rounded-pill px-3 py-1 fw-bold fs-7 d-none d-md-inline-block">
                        <i class="bi bi-person me-1"></i> Sign In
                    </a>
                </div>
            </div>

            <!-- Mobile Search Bar -->
            <div class="mt-2 d-md-none">
                <form action="/category/search" method="get" class="position-relative">
                    <input type="text" name="q" class="form-control lm-search-input" placeholder="Search products..." />
                    <button type="submit" class="lm-search-btn" title="Search"><i class="bi bi-search"></i></button>
                </form>
            </div>
        </div>
    </header>

    <!-- Navigation Bar -->
    <nav class="lm-main-nav">
        <div class="container lm-main-nav-inner">
            <a href="/" class="lm-nav-link active">HOME</a>
            <a href="/category/new-arrival" class="lm-nav-link">NEW ARRIVAL</a>
            <a href="/category/saree" class="lm-nav-link">SAREE</a>
            <a href="/category/three-piece" class="lm-nav-link">THREE PIECE</a>
            <a href="/category/kurti" class="lm-nav-link">KURTI</a>
            <a href="/category/innerwear" class="lm-nav-link">INNERWEAR</a>
            <a href="/category/jewelry" class="lm-nav-link">JEWELRY</a>
            <a href="/category/bags" class="lm-nav-link">BAGS</a>
            <a href="/category/cosmetics" class="lm-nav-link">COSMETICS</a>
            <a href="/category/sale" class="lm-nav-link text-danger">SALE</a>
            <a href="/about" class="lm-nav-link">ABOUT US</a>
            <a href="/contact" class="lm-nav-link">CONTACT</a>
        </div>
    </nav>

    <!-- Main Render Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-top mt-5 pt-5 pb-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="lm-logo-container mb-3">
                        <div class="lm-logo-badge">LM</div>
                        <div class="lm-logo-text">
                            <span class="lm-logo-title">@HeaderModel.Settings.SiteName</span>
                            <span class="lm-logo-bengali">@HeaderModel.Settings.SiteBengaliName</span>
                        </div>
                    </div>
                    <p class="small text-muted mb-3">@FooterModel.StoreSettings.FooterAboutText</p>
                    
                    <!-- Social Media Links Icons -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @if (!string.IsNullOrWhiteSpace(FooterModel.StoreSettings.FacebookUrl))
                        {
                            <a href="@FooterModel.StoreSettings.FacebookUrl" target="_blank" class="btn btn-sm btn-light border text-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center lm-social-icon-btn shadow-sm" style="width:38px; height:38px;" title="Facebook Page">
                                <i class="bi bi-facebook fs-5"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(FooterModel.StoreSettings.InstagramUrl))
                        {
                            <a href="@FooterModel.StoreSettings.InstagramUrl" target="_blank" class="btn btn-sm btn-light border text-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center lm-social-icon-btn shadow-sm" style="width:38px; height:38px;" title="Instagram Profile">
                                <i class="bi bi-instagram fs-5"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(FooterModel.StoreSettings.YoutubeUrl))
                        {
                            <a href="@FooterModel.StoreSettings.YoutubeUrl" target="_blank" class="btn btn-sm btn-light border text-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center lm-social-icon-btn shadow-sm" style="width:38px; height:38px;" title="YouTube Channel">
                                <i class="bi bi-youtube fs-5"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(FooterModel.StoreSettings.WhatsappNumber))
                        {
                            <a href="https://wa.me/@FooterModel.StoreSettings.WhatsappNumber.Replace("+", "").Replace(" ", "")" target="_blank" class="btn btn-sm btn-light border text-success rounded-circle p-0 d-inline-flex align-items-center justify-content-center lm-social-icon-btn shadow-sm" style="width:38px; height:38px;" title="WhatsApp Support">
                                <i class="bi bi-whatsapp fs-5"></i>
                            </a>
                        }
                    </div>

                    <p class="small text-muted mb-0">@FooterModel.StoreSettings.CopyrightText</p>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="fw-bold mb-3">SHOP CATEGORIES</h6>
                    <ul class="list-unstyled small text-muted lh-lg mb-0">
                        <li><a href="/category/saree">Sarees & Ethnic Wear</a></li>
                        <li><a href="/category/three-piece">Three Piece & Kurtis</a></li>
                        <li><a href="/category/jewelry">Jewelry & Accessories</a></li>
                        <li><a href="/category/bags">Bags & Purses</a></li>
                        <li><a href="/category/cosmetics">Cosmetics & Perfumes</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="fw-bold mb-3">CUSTOMER SERVICE</h6>
                    <ul class="list-unstyled small text-muted lh-lg mb-0">
                        <li><i class="bi bi-telephone me-1 text-danger"></i> @FooterModel.StoreSettings.SupportPhone</li>
                        <li><i class="bi bi-envelope me-1 text-primary"></i> @FooterModel.StoreSettings.SupportEmail</li>
                        <li><i class="bi bi-clock me-1 text-warning"></i> @FooterModel.StoreSettings.BusinessHours</li>
                        <li><i class="bi bi-geo-alt me-1 text-danger"></i> @FooterModel.StoreSettings.StoreLocation</li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">CONNECT & WE ACCEPT</h6>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        @if (FooterModel.StoreSettings.ShowBkash)
                        {
                            <span class="badge bg-danger p-2">bKash</span>
                        }
                        @if (FooterModel.StoreSettings.ShowNagad)
                        {
                            <span class="badge bg-warning text-dark p-2">Nagad</span>
                        }
                        @if (FooterModel.StoreSettings.ShowVisa)
                        {
                            <span class="badge bg-primary p-2">VISA</span>
                        }
                        @if (FooterModel.StoreSettings.ShowMastercard)
                        {
                            <span class="badge bg-secondary p-2">Mastercard</span>
                        }
                        @if (FooterModel.StoreSettings.ShowBanglaQR)
                        {
                            <span class="badge bg-success p-2">BanglaQR</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Mobile Sticky Navigation Bar (PWA & Touch Friendly) -->
    <div class="lm-mobile-bottom-nav">
        <a href="/" class="lm-action-item active">
            <i class="bi bi-house lm-action-icon"></i>
            <span>Home</span>
        </a>
        <a href="#" class="lm-action-item" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
            <i class="bi bi-grid lm-action-icon"></i>
            <span>Categories</span>
        </a>
        <a href="/account/wishlist" class="lm-action-item">
            <i class="bi bi-heart lm-action-icon"></i>
            <span>Wishlist</span>
        </a>
        <a href="/account/login" class="lm-action-item">
            <i class="bi bi-person lm-action-icon"></i>
            <span>Account</span>
        </a>
        <a href="/cart" class="lm-action-item">
            <i class="bi bi-bag lm-action-icon"></i>
            <span class="lm-badge">2</span>
            <span>Cart</span>
        </a>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js');
            });
        }

        // PWA Install Prompt Logic
        let deferredPrompt;
        const installBtn = document.getElementById('pwaInstallBtn');

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            if (installBtn) installBtn.style.display = 'inline-block';

            if (installBtn) {
                installBtn.addEventListener('click', async () => {
                    installBtn.style.display = 'none';
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    deferredPrompt = null;
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>